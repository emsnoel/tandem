#!/usr/bin/env bash
# tandem-init: make a repo ready for the Herdr planner/builder harness.
#
# Writes <repo>/.tandem.json from the settings tandem detects, and ignores the
# relay mailbox. Safe to run in any repo; it changes nothing else.
set -euo pipefail

ROOT=""
FORCE=0

usage() { cat <<'USAGE'
usage: tandem-init [--root DIR] [--force]

Creates <repo>/.tandem.json from detected settings and adds .tandem-relay/ to
.gitignore. Review the file afterwards. Detection is only a starting point.

  --root DIR   repo to initialise (default: the current git repo, else $PWD)
  --force      overwrite an existing .tandem.json
USAGE
}

die()  { printf 'tandem-init: %s\n' "$*" >&2; exit 1; }
info() { printf 'tandem-init: %s\n' "$*"; }

while (( $# )); do
  case "$1" in
    --root)  ROOT="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
done

command -v tandem >/dev/null 2>&1 || die "tandem not found on PATH; run install.sh."

if [[ -z "$ROOT" ]]; then
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
  ROOT="${ROOT:-$PWD}"
fi
[[ -d "$ROOT" ]] || die "not a directory: $ROOT"

# tandem answers in NUL-separated fields, read from this file.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS"' EXIT
# read_field VAR reads the next field into VAR, dropping trailing newlines as
# command substitution did.
read_field() {
  local __v=""
  IFS= read -r -d '' __v || true
  while [[ "$__v" == *$'\n' ]]; do __v="${__v%$'\n'}"; done
  printf -v "$1" '%s' "$__v"
}

tandem config project --root "$ROOT" --fields >"$FIELDS" 2>/dev/null \
  || die "the installed tandem is behind these commands (no 'tandem config project'); re-run install.sh."
# Fields 1 to 13 are the settings in the order tandem-project prints them,
# apart from check_paths, which come last; 14 names a manifest that is not a
# JSON object.
KEYS=(root plans_dir check_command conventions_file builder_kind prompt_extra
      task_input_budget context_limit build_engine review_delivery acceptance_policy
      collaboration source)
VALUES=()
CHECK_PATHS=""; _v=""
{ for _ in "${KEYS[@]}"; do read_field _v; VALUES+=("$_v"); done
  read_field _invalid_manifest
  while IFS= read -r -d '' _p; do CHECK_PATHS="${CHECK_PATHS:+$CHECK_PATHS, }$_p"; done; } <"$FIELDS"
if [[ -n "$_invalid_manifest" ]]; then
  printf 'tandem-init: %s is not a JSON object, so its settings were ignored.\n' "$_invalid_manifest" >&2
fi
PLANS_DIR="${VALUES[1]}"; CHECK_COMMAND="${VALUES[2]}"; CONVENTIONS_FILE="${VALUES[3]}"; BUILDER_KIND="${VALUES[4]}"

MANIFEST=$(tandem paths manifest --root "$ROOT") \
  || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
if [[ -f "$MANIFEST" && $FORCE -eq 0 ]]; then
  info "$MANIFEST already exists; leaving it alone (--force to overwrite)."
else
  tandem config write-manifest --file "$MANIFEST" --plans-dir "$PLANS_DIR" --check-command "$CHECK_COMMAND" \
      --conventions-file "$CONVENTIONS_FILE" --builder-kind "$BUILDER_KIND" 2>/dev/null \
    || die "could not write $MANIFEST."
  info "wrote $MANIFEST"
fi

# The mailbox holds in-flight relay traffic and must never be committed.
GI="$ROOT/.gitignore"
RELAY_BASE=$(tandem paths relay --root "$ROOT") \
  || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
RELAY_BASE=$(basename "$RELAY_BASE")
RELAY_RE="^/?${RELAY_BASE//./\\.}/?$"
if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  if [[ -f "$GI" ]] && grep -qE "$RELAY_RE" "$GI"; then
    info ".gitignore already ignores $RELAY_BASE/"
  else
    printf '\n# tandem agent relay mailbox (local IPC, never committed)\n%s/\n' "$RELAY_BASE" >> "$GI"
    info "added $RELAY_BASE/ to .gitignore"
  fi
else
  info "not a git repo, so .gitignore was left alone. The relay will use $ROOT/$RELAY_BASE."
fi

# tandem-ask's Q&A history is local and never committed.
LOG_BASE=".tandem-log"
LOG_RE="^/?${LOG_BASE//./\\.}/?$"
if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  if [[ -f "$GI" ]] && grep -qE "$LOG_RE" "$GI"; then
    info ".gitignore already ignores $LOG_BASE/"
  else
    printf '\n# tandem-ask durable Q&A history (local, never committed)\n%s/\n' "$LOG_BASE" >> "$GI"
    info "added $LOG_BASE/ to .gitignore"
  fi
else
  info "not a git repo, so .gitignore was left alone. The log will use $ROOT/$LOG_BASE."
fi

# The listing keeps tandem-project's key order, with check_paths after
# prompt_extra.
show() { printf '    %s: %s\n' "$1" "${2:-(none)}"; }
printf '\n'
info "resolved settings:"
for i in "${!KEYS[@]}"; do
  show "${KEYS[$i]}" "${VALUES[$i]}"
  [[ "${KEYS[$i]}" != prompt_extra ]] || show check_paths "$CHECK_PATHS"
done
printf '\n'
[[ -n "$PLANS_DIR" ]] \
  || info "NOTE no plans directory was found. Set plans_dir in .tandem.json, or pass a plan path to tandem-handoff."
[[ -n "$CHECK_COMMAND" ]] \
  || info "NOTE no check command was found. Set check_command so the builder can check its work."
[[ -n "$CONVENTIONS_FILE" ]] \
  || info "NOTE no AGENTS.md was found, so the builder starts with no project conventions."
