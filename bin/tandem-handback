#!/usr/bin/env bash
# tandem-handback: hand finished work back to the planner.
#
# The return leg of tandem-handoff, run by the builder. The report is written
# to a file and the planner gets its path, because terminals collapse long
# output. It does not wait for verification, which can take longer than the
# builder's command timeout.
#
# See README.md.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/reviewer.sh
. "${_self%/*}/lib/reviewer.sh"
HANDBACK_LIB="${_self%/*}/lib"
# shellcheck source=lib/handback-task.sh
. "$HANDBACK_LIB/handback-task.sh"
# shellcheck source=lib/handback-deliver.sh
. "$HANDBACK_LIB/handback-deliver.sh"

PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"
# Bounded wait for a planner at a permission dialog.
BLOCKED_WAIT_SECONDS="${HERDR_HANDBACK_BLOCKED_WAIT_SECONDS:-90}"

DRY_RUN=0
REPORT_FILE=""
PLAN_PATH=""
TASK=""
STUCK=0
REVIEW=0
VERDICT=""
ROLE=""
STARTED=0
REVIEW_STARTED=0
REVIEW_RESULT=""
RUN_ID=""; ATTEMPT_ID=""; JOB_ID=""; EFFECT_ID=""; NONCE=""

usage() {
  cat <<'USAGE'
usage: tandem-handback [--report FILE|-] [--plan PATH] [--task N [--stuck | --review --verdict clean|changes]] [--role NAME] [--dry-run]

Tells the planner the plan is implemented and hands it the completion report.
Run this from the builder when you finish; it is how the session gets closed.

With --task, hands back ONE task of a build tandem is running: the report is
queued for the relay bridge, which checks the task and sends the next one to
a fresh conversation. It never goes to the planner directly.

  --report FILE   file holding the report. "-" or omitted reads stdin.
  --plan PATH     the plan that was implemented, named in the message
  --task N        the build task being handed back
  --stuck         with --task: the task could not be finished
  --review        with --task: the reviewer pane's review of the task. Needs
                  --verdict. The builder never reviews, so this is refused
                  from any pane but the build's reviewer.
  --verdict V     with --review: clean (nothing to fix) or changes (the
                  builder fixes what the report lists)
  --role NAME     the pane this runs in, when the CLI does not pass
                  HERDR_ROLE to the commands it runs
  --started       with --task and a durable run: acknowledge that you read the
                  task prompt, before you edit anything. Needs no report.
  --review-started
                  with --task and a durable run that opted in to direct review
                  handback: acknowledge that you read the review prompt.
  --review-result FILE
                  with --task and such a run: hand back the review result, one
                  JSON object in FILE. It is staged; Tandem applies it only
                  once your turn has ended.
  --run ID --attempt ID --job ID --effect ID --nonce ID
                  a durable run's identity, copied from the task prompt. Only
                  valid while a durable run is active; with one, they are
                  required and the old form is refused.
  --dry-run       show what would be sent without sending it

The report should say: which tasks are complete, the exact state of the test
suite, anything changed that the plan did not ask for, and anything you could
not verify.
USAGE
}

die()  { printf 'tandem-handback: %s\n' "$*" >&2; exit 1; }
info() { printf 'tandem-handback: %s\n' "$*" >&2; }

while (( $# )); do
  case "$1" in
    --report)  REPORT_FILE="${2:-}"; shift 2 ;;
    --plan)    PLAN_PATH="${2:-}"; shift 2 ;;
    --task)    TASK="${2:-}"; shift 2 ;;
    --stuck)   STUCK=1; shift ;;
    --review)  REVIEW=1; shift ;;
    --verdict) VERDICT="${2:-}"; shift 2 ;;
    --role)    ROLE="${2:-}"; shift 2 ;;
    --started) STARTED=1; shift ;;
    --review-started) REVIEW_STARTED=1; shift ;;
    --review-result)  REVIEW_RESULT="${2:-}"; shift 2 ;;
    --run)     RUN_ID="${2:-}"; shift 2 ;;
    --attempt) ATTEMPT_ID="${2:-}"; shift 2 ;;
    --job)     JOB_ID="${2:-}"; shift 2 ;;
    --effect)  EFFECT_ID="${2:-}"; shift 2 ;;
    --nonce)   NONCE="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         usage >&2; die "unknown argument: $1" ;;
  esac
done

# Fail early if herdr is missing; tandem shells out to it.
command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
command -v tandem >/dev/null 2>&1 || die "tandem not found on PATH."
[[ "$BLOCKED_WAIT_SECONDS" =~ ^[0-9]+$ && "$BLOCKED_WAIT_SECONDS" -gt 0 ]] \
  || die "HERDR_HANDBACK_BLOCKED_WAIT_SECONDS must be a positive integer."
if [[ -n "$TASK" ]]; then
  [[ "$TASK" =~ ^[1-9][0-9]*$ ]] || die "--task takes a task number, not '$TASK'."
elif (( STUCK )); then
  die "--stuck only means something with --task."
elif (( STARTED )); then
  die "--started only means something with --task."
elif (( REVIEW )); then
  die "--review only means something with --task."
elif (( REVIEW_STARTED )) || [[ -n "$REVIEW_RESULT" ]]; then
  die "--review-started and --review-result only mean something with --task."
fi
if [[ -n "$VERDICT" ]] && (( ! REVIEW )); then
  die "--verdict only means something with --review."
fi
if (( REVIEW && STUCK )); then
  die "--review takes no --stuck: a reviewer hands back a verdict. Nothing was sent."
fi
if (( REVIEW )) && [[ -z "$RUN_ID" ]]; then
  [[ "$VERDICT" == clean || "$VERDICT" == changes ]] \
    || die "--review needs --verdict clean or --verdict changes (got '${VERDICT}'). Nothing was sent."
fi
[[ -z "$ROLE" || "$ROLE" =~ ^[A-Za-z0-9_-]+$ ]] || die "--role must be a pane name such as reviewer (got '$ROLE')."
if (( REVIEW_STARTED )) && [[ -n "$REVIEW_RESULT" ]]; then
  die "--review-started and --review-result are two messages; send them one at a time."
fi
if (( REVIEW_STARTED )) || [[ -n "$REVIEW_RESULT" ]]; then
  (( STARTED || STUCK || REVIEW )) && die "a review message cannot be combined with --started, --stuck or --review."
  [[ -z "$REPORT_FILE" ]] || die "a review message takes no --report; the result is the file after --review-result."
fi

durable_handback

# Legacy delivery below needs the Herdr pane environment.
[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."

# --- read the report ---
# Refuse an empty report; it gives the planner nothing to check.
if [[ -n "$REPORT_FILE" && "$REPORT_FILE" != "-" ]]; then
  [[ -f "$REPORT_FILE" ]] || die "report file not found: $REPORT_FILE"
  REPORT=$(cat "$REPORT_FILE")
else
  if [[ -t 0 ]]; then
    usage >&2
    die "no report given. Pass --report FILE, or pipe the report in on stdin."
  fi
  REPORT=$(cat)
fi
[[ -n "${REPORT//[[:space:]]/}" ]] || die "the report is empty; nothing to hand back."

if [[ -n "$PLAN_PATH" && -f "$PLAN_PATH" ]]; then
  PLAN_PATH=$(cd "$(dirname "$PLAN_PATH")" && printf '%s/%s' "$(pwd)" "$(basename "$PLAN_PATH")")
fi

# --- where the report lands ---
# Inside the relay, which is already ignored and cleared by tandem-unpair.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
ROOT="${ROOT:-$PWD}"
MAILBOX=$(tandem paths relay --root "$ROOT") \
  || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
ID="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
REPORT_PATH="$MAILBOX/reports/$ID.md"

# Who is handing back: --role, then HERDR_ROLE, then Herdr's name for the pane,
# then the builder. A CLI may not pass the pane's environment to its commands.
# For a review, tandem decides below whether this shell is the reviewer.
SELF="${ROLE:-${HERDR_ROLE:-}}"
if (( ! REVIEW )); then
  [[ -n "$SELF" ]] || SELF=$(tandem agent self 2>/dev/null) || SELF=""
  SELF="${SELF:-builder}"
fi
[[ "$SELF" != "$PLANNER_NAME" ]] || die "refusing to hand work back to yourself."

task_handback
build_message
print_dry_run
deliver_handback

info "handed back to '$PLANNER_NAME'."
info "it will verify the work and close this pane with tandem-unpair. Stay idle."
