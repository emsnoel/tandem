#!/usr/bin/env bash
# tandem-relaylog: print the Q&A history tandem-ask records.
#
# Read-only. tandem-ask writes each exchange to .tandem-log/<id>.json, and
# tandem-unpair never removes that directory.
#
# See README.md.
set -uo pipefail

LIMIT=0
AS_JSON=0

usage() {
  cat <<'USAGE'
usage: tandem-relaylog [--limit N] [--json]

Prints the durable Q&A history tandem-ask has recorded, oldest first.

  --limit N   print only the N most recent exchanges (default: all)
  --json      print raw JSON records, one per line, instead of formatted text
USAGE
}

die() { printf 'tandem-relaylog: %s\n' "$*" >&2; exit 1; }

while (( $# )); do
  case "$1" in
    --limit)   LIMIT="${2:-}"; shift 2 ;;
    --json)    AS_JSON=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         usage >&2; die "unknown argument: $1" ;;
  esac
done
[[ "$LIMIT" =~ ^[0-9]+$ ]] || die "--limit takes a whole number, such as 5."

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")
LOG_DIR="$ROOT/.tandem-log"

if [[ ! -d "$LOG_DIR" ]]; then
  printf 'tandem-relaylog: no history yet at %s\n' "$LOG_DIR" >&2
  exit 0
fi

# tandem sorts the records oldest first, keeps the last LIMIT, and leaves out
# review triage's judge-<id>.json files. Each record is 8 NUL-separated fields.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS"' EXIT
tandem relay history --dir "$LOG_DIR" --limit "$LIMIT" >"$FIELDS" 2>/dev/null \
  || die "the installed tandem is behind these commands (no 'tandem relay history'); re-run install.sh."
if [[ ! -s "$FIELDS" ]]; then
  printf 'tandem-relaylog: no history yet at %s\n' "$LOG_DIR" >&2
  exit 0
fi

while IFS= read -r -d '' file && IFS= read -r -d '' json \
      && IFS= read -r -d '' id && IFS= read -r -d '' ts && IFS= read -r -d '' from \
      && IFS= read -r -d '' to && IFS= read -r -d '' question && IFS= read -r -d '' answer; do
  if [[ -z "$json" ]]; then
    printf 'tandem-relaylog: skipped %s, it is not a JSON record.\n' "$file" >&2
  elif (( AS_JSON )); then
    printf '%s\n' "$json"
  else
    printf '%s  %s  %s -> %s\n  Q: %s\n  A: %s\n\n' "$id" "$ts" "$from" "$to" "$question" "$answer"
  fi
done <"$FIELDS"
