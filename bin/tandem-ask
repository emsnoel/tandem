#!/usr/bin/env bash
# tandem-ask: ask the paired agent a question and print its reply to stdout.
#
# Run by an agent, not a human, so the reply lands in the asker's own context.
# The message carries its own attribution ("[from builder]").
#
# See README.md.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/ask-mailbox.sh
. "${_self%/*}/lib/ask-mailbox.sh"

# The default depends on direction (see below). HERDR_ASK_TIMEOUT_SECONDS
# overrides it, and --timeout overrides that.
TIMEOUT_SECONDS="${HERDR_ASK_TIMEOUT_SECONDS:-}"
READ_LINES="${HERDR_ASK_READ_LINES:-120}"
# Progress lines while waiting, so a caller can tell waiting from dead.
HEARTBEAT_SECONDS="${HERDR_ASK_HEARTBEAT_SECONDS:-10}"
DRY_RUN=0
TARGET=""
QUESTION=""

usage() {
  cat <<'USAGE'
usage: tandem-ask <planner|builder> "question text" [--timeout SECONDS] [--lines N]

Sends a question to the paired agent and prints its reply. Always bounded: if the
peer does not answer within the timeout, this returns control with a fallback
message rather than blocking forever.

This BLOCKS while it waits and prints progress to stderr. Do not re-run it because
it is taking a while. The question is delivered once, and a duplicate costs the
peer a second interruption.

  --timeout SECONDS   how long to wait for an answer. Default depends on the
                      target: 300 when asking the planner, which may need to
                      read code before answering; 90 when asking the builder,
                      because Claude Code's Bash tool kills a command at 120s
  --lines N           how many lines of the peer's output to print (default: 120)
  --dry-run           show what would be sent without sending it
USAGE
}

die()  { printf 'tandem-ask: %s\n' "$*" >&2; exit 1; }
info() { printf 'tandem-ask: %s\n' "$*" >&2; }

while (( $# )); do
  case "$1" in
    --timeout) TIMEOUT_SECONDS="${2:-}"; shift 2 ;;
    --lines)   READ_LINES="${2:-}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)        usage >&2; die "unknown option: $1" ;;
    *)
      if   [[ -z "$TARGET"   ]]; then TARGET="$1"
      elif [[ -z "$QUESTION" ]]; then QUESTION="$1"
      else die "unexpected argument: $1"
      fi
      shift ;;
  esac
done

[[ -n "$TARGET"   ]] || { usage >&2; die "no target agent given."; }
[[ -n "$QUESTION" ]] || { usage >&2; die "no question given."; }

# Direction-aware default:
#   asking the builder (90s): the caller is usually Claude Code, whose Bash
#     tool kills a command at 120s, so the fallback below must run before that.
#   asking the planner (300s): the planner may need to read code first, and
#     the sandboxed builder has no such limit.
if [[ -z "$TIMEOUT_SECONDS" ]]; then
  case "$TARGET" in
    planner) TIMEOUT_SECONDS=300 ;;
    *)       TIMEOUT_SECONDS=90  ;;
  esac
fi

[[ "$TIMEOUT_SECONDS" =~ ^[0-9]+$ && "$TIMEOUT_SECONDS" -gt 0 ]] || die "--timeout must be a positive integer."
[[ "$READ_LINES"      =~ ^[0-9]+$ && "$READ_LINES"      -gt 0 ]] || die "--lines must be a positive integer."

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
# Fail early if herdr is missing; tandem shells out to it.
command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
command -v tandem >/dev/null 2>&1 || die "tandem not found on PATH."

TIMEOUT_MS=$(( TIMEOUT_SECONDS * 1000 ))

# One id per exchange, shared by the mailbox files and the history record.
ID="$(date +%Y%m%d-%H%M%S)-$$-$RANDOM"
# The git toplevel, as mailbox_dir resolves it. log_exchange needs it in direct
# mode too.
LOG_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")


rc=0
_snap=$(tandem agent snapshot "$TARGET" 2>/dev/null) || rc=$?
case "$rc" in
  0) ;;
  3) ask_via_mailbox ;;
  *) die "could not reach '$TARGET'." ;;
esac
IFS=$'\t' read -r TARGET_PANE _ TARGET_STATUS <<<"$_snap"

SELF=$(tandem agent self 2>/dev/null) || SELF=""
SELF="${SELF:-peer}"
[[ "$SELF" != "$TARGET" ]] || die "refusing to send a question to yourself."

MESSAGE="[from $SELF] $QUESTION"

if (( DRY_RUN )); then
  printf 'tandem-ask: target %s (pane %s, status: %s)\n' "$TARGET" "$TARGET_PANE" "$TARGET_STATUS"
  printf '  [dry-run] herdr agent prompt %s "%s" --wait --timeout %s\n' "$TARGET" "$MESSAGE" "$TIMEOUT_MS"
  printf '  [dry-run] herdr agent read %s --source recent-unwrapped --lines %s\n' "$TARGET" "$READ_LINES"
  exit 0
fi

# One deadline covers waiting and answering.
DEADLINE=$(( SECONDS + TIMEOUT_SECONDS ))
remaining_ms() {
  local r=$(( DEADLINE - SECONDS ))
  (( r < 5 )) && r=5
  printf '%s' $(( r * 1000 ))
}

# Herdr rejects a prompt to a blocked agent before writing anything. Blocked is
# usually a permission dialog that clears in seconds, so wait for it. Never type
# into someone else's dialog.
if [[ "$TARGET_STATUS" == blocked ]]; then
  info "$TARGET is blocked (usually a permission dialog); waiting up to ${TIMEOUT_SECONDS}s for it to clear..."
  rc=0
  tandem agent wait "$TARGET" --until idle --until done --until working \
    --timeout "$(remaining_ms)" >/dev/null 2>&1 || rc=$?
  if (( rc != 0 )); then
    cat >&2 <<MSG
tandem-ask: $TARGET was still blocked after ${TIMEOUT_SECONDS}s; nothing was sent.

  It is waiting on a human, not on you. Proceed and state your assumption
  explicitly, or stop and ask the human to clear pane $TARGET_PANE.
MSG
    exit 3
  fi
  info "$TARGET cleared; sending."
fi

info "asking $TARGET (waiting up to ${TIMEOUT_SECONDS}s)..."

rc=0
_perr=$(tandem agent prompt "$TARGET" "$MESSAGE" --wait \
  --timeout "$(remaining_ms)" 2>&1 >/dev/null) || rc=$?
if (( rc != 0 )); then
  IFS=$'\t' read -r _code _msg <<<"$_perr"
  case "$_code" in
    agent_blocked)
      cat >&2 <<MSG
tandem-ask: $TARGET hit a dialog between the status check and the send; nothing was sent.
           Retry, or ask the human to clear pane $TARGET_PANE.
MSG
      exit 3 ;;
    agent_input_elsewhere)
      cat >&2 <<MSG
tandem-ask: nothing was sent. ${_msg}.
           Proceed and state your assumption, or ask the human to return pane $TARGET_PANE to its main conversation.
MSG
      exit 3 ;;
    agent_prompt_stalled)
      cat >&2 <<MSG
tandem-ask: the question reached $TARGET but it showed no lifecycle change.
MSG
      exit 4 ;;
    *)
      # Timeout or transport failure: return control to the caller.
      cat >&2 <<MSG
tandem-ask: no answer from $TARGET within ${TIMEOUT_SECONDS}s (${_msg:-unknown error}).

  Do not keep waiting. Either proceed and state the assumption you are making
  explicitly in your next message, or stop and ask the human directly.
MSG
      exit 5 ;;
  esac
fi

FINAL_STATUS=$(tandem agent status "$TARGET" 2>/dev/null || printf 'unknown')

if [[ "$FINAL_STATUS" == blocked ]]; then
  info "$TARGET is now blocked at a dialog; the text below may be incomplete."
fi

rc=0
REPLY=$(tandem agent read "$TARGET" --source recent-unwrapped \
  --lines "$READ_LINES" 2>&1) || rc=$?
if (( rc != 0 )); then
  IFS=$'\t' read -r _code _msg <<<"$REPLY"
  die "could not read $TARGET's output: ${_msg:-unknown error}"
fi

if [[ -z "${REPLY//[[:space:]]/}" ]]; then
  cat >&2 <<MSG
tandem-ask: $TARGET settled ($FINAL_STATUS) but returned no readable text.

  This usually means the agent is painting on the terminal's alternate screen,
  where scrolled-off rows cannot be recovered by raising --lines. Ask the human
  to read pane $TARGET_PANE, or re-ask requesting the answer be written to a
  file whose path is the only reply.
MSG
  exit 6
fi

printf -- '--- reply from %s (status: %s) ---\n' "$TARGET" "$FINAL_STATUS"
printf '%s\n' "$REPLY"
printf -- '--- end reply ---\n'
log_exchange "$SELF" "$TARGET" "$QUESTION" "$REPLY" || true
