#!/usr/bin/env bash
# tandem-pair: establish or repair the planner, builder and reviewer panes.
#
# Idempotent. It adopts agents that are already running, so it can repair a
# half-set-up session. See README.md.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/reviewer.sh
. "${_self%/*}/lib/reviewer.sh"
# shellcheck source=lib/relay.sh
. "${_self%/*}/lib/relay.sh"
# shellcheck source=lib/pair-launch.sh
. "${_self%/*}/lib/pair-launch.sh"
# shellcheck source=lib/pair-panes.sh
. "${_self%/*}/lib/pair-panes.sh"
# shellcheck source=lib/pair-records.sh
. "${_self%/*}/lib/pair-records.sh"

PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"
BUILDER_NAME="${HERDR_BUILDER_NAME:-builder}"
REVIEWER_NAME="${HERDR_REVIEWER_NAME:-reviewer}"
PLANNER_KIND="claude"
START_TIMEOUT_MS="${HERDR_PAIR_START_TIMEOUT_MS:-60000}"

DRY_RUN=0
SKIP_DOCTOR=0
DIRECTION=""
PLANNER_PANE=""
CWD_OVERRIDE=""
OV_BUILDER_KIND=""
OV_BUILDER_MODEL=""
OV_BUILDER_EFFORT=""
OV_BUILDER_AUTONOMY=""
# A space-separated string, because bash 3.2 treats an empty array as unset
# under set -u.
OV_APPROVE_KINDS=""
OV_REVIEWER_KIND=""
OV_REVIEWER_MODEL=""
OV_REVIEWER_EFFORT=""

usage() {
  cat <<'USAGE'
usage: tandem-pair [--dry-run] [--direction right|down] [--planner-pane ID]

Names the Claude agent "planner". Starts or adopts the configured builder in a
pane beside it and the configured reviewer below the builder, and labels each
pane for the Herdr sidebar.

  --dry-run           print the mutating herdr calls without making them
  --skip-doctor       pair without running `tandem doctor` first
  --direction DIR     force split direction (default: derived from pane shape)
  --planner-pane ID   use this pane as the planner (default: auto-detected)
  --cwd PATH          working directory for the builder pane. Defaults to the
                      planner's own cwd, which is not always the repo you mean.
  --builder KIND      agent CLI for the builder (codex|claude|copilot|opencode)
  --builder-model M   model override for the builder
  --builder-effort E  effort override (low|medium|high|max)
  --builder-autonomy A
                      autonomy override (readonly|ask|auto|full)
  --approve-kind K    approve a kind requested by this repository, then pair.
                      Repeat it to approve the builder's and the reviewer's
                      kinds in one run
  --reviewer KIND     the agent CLI for the reviewer, overriding the "reviewer"
                      block in .tandem.json. Every review is sent to
                      the reviewer pane, never to the builder, so the builder
                      can run a cheap model and the review a strong one. It is
                      never the builder or the planner.
  --reviewer-model M  model for the reviewer (overrides .tandem.json)
  --reviewer-effort E effort for the reviewer (overrides .tandem.json)

The reviewer is started when .tandem.json has a "reviewer" block
with a kind, or --reviewer is given. With neither, the pair is made without
one and review and build will refuse until one is configured.
USAGE
}

die()  { printf 'tandem-pair: %s\n' "$*" >&2; exit 1; }
info() { printf 'tandem-pair: %s\n' "$*"; }

while (( $# )); do
  case "$1" in
    --dry-run)      DRY_RUN=1; shift ;;
    --skip-doctor)  SKIP_DOCTOR=1; shift ;;
    --direction)    DIRECTION="${2:-}"; shift 2 ;;
    --planner-pane) PLANNER_PANE="${2:-}"; shift 2 ;;
    --cwd)          CWD_OVERRIDE="${2:-}"; shift 2 ;;
    --builder)           OV_BUILDER_KIND="${2:-}";     shift 2 ;;
    --builder-model)     OV_BUILDER_MODEL="${2:-}";    shift 2 ;;
    --builder-effort)    OV_BUILDER_EFFORT="${2:-}";   shift 2 ;;
    --builder-autonomy)  OV_BUILDER_AUTONOMY="${2:-}"; shift 2 ;;
    --approve-kind)       OV_APPROVE_KINDS="$OV_APPROVE_KINDS ${2:-}"; shift 2 ;;
    --reviewer)          OV_REVIEWER_KIND="${2:-}";    shift 2 ;;
    --reviewer-model)    OV_REVIEWER_MODEL="${2:-}";   shift 2 ;;
    --reviewer-effort)   OV_REVIEWER_EFFORT="${2:-}";  shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *)              usage >&2; die "unknown argument: $1" ;;
  esac
done

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
command -v tandem >/dev/null 2>&1 || die "tandem not found on PATH."
[[ -z "$DIRECTION" || "$DIRECTION" == right || "$DIRECTION" == down ]] \
  || die "--direction must be right or down (got: $DIRECTION)."
[[ -z "$CWD_OVERRIDE" || -d "$CWD_OVERRIDE" ]] || die "--cwd is not a directory: $CWD_OVERRIDE"
[[ "$REVIEWER_NAME" != "$BUILDER_NAME" && "$REVIEWER_NAME" != "$PLANNER_NAME" ]] \
  || die "the reviewer cannot be named '$REVIEWER_NAME': that is the builder or the planner, which would review its own work."

# Go writes NUL-separated fields here, which a bash variable cannot hold.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS" "${PRE_ERR:-}"' EXIT

# --- resolve the planner pane ---
# Order: explicit flag, the calling pane, the only claude agent. From a popup,
# $HERDR_PANE_ID is the popup's pane, not the planner's.
rc=0
_err=$(tandem agent planner ${PLANNER_PANE:+--pane "$PLANNER_PANE"} --kind "$PLANNER_KIND" 2>&1 >"$FIELDS") || rc=$?
case "$rc" in
  0)
    { IFS= read -r -d '' PLANNER_PANE; IFS= read -r -d '' PLANNER_CWD
      IFS= read -r -d '' PLANNER_TAB; IFS= read -r -d '' PLANNER_CURRENT_NAME; } < "$FIELDS" || true ;;
  31)
    die "no running $PLANNER_KIND agent found. Start Claude Code in a pane first." ;;
  32)
    count=0; _list=""
    while IFS= read -r -d '' _p && IFS= read -r -d '' _n && IFS= read -r -d '' _c; do
      count=$((count + 1))
      _list="$_list  $_p  name=${_n:--}  cwd=${_c:--}"$'\n'
    done < "$FIELDS"
    printf 'tandem-pair: %s %s agents are running; cannot pick one automatically:\n' "$count" "$PLANNER_KIND" >&2
    printf '%s' "$_list" >&2
    die "re-run with --planner-pane <pane_id>." ;;
  *)
    die "could not list agents: $(printf '%s' "$_err" | cut -f2-)" ;;
esac

info "planner pane: $PLANNER_PANE (cwd: ${PLANNER_CWD:-unknown})"

SPLIT_CWD="${CWD_OVERRIDE:-${PLANNER_CWD:-$PWD}}"
ROOT=$(git -C "$SPLIT_CWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$SPLIT_CWD")

for _kind in $OV_APPROVE_KINDS; do
  tandem config approve-kind --root "$ROOT" --kind "$_kind" >/dev/null \
    || die "could not record approval for kind '$_kind'."
done

# --- doctor ---
# Every setup problem at once, before any pane opens. The per-pane gates below
# still run, because the machine can change between the two. A dry run checks
# too: doctor writes nothing. --problems prints only failures and warnings, and
# nothing when every check passes.
if (( ! SKIP_DOCTOR )); then
  doctor_args=(--problems --cwd "$SPLIT_CWD")
  [[ -n "$OV_BUILDER_KIND" ]]     && doctor_args+=(--builder "$OV_BUILDER_KIND")
  [[ -n "$OV_BUILDER_MODEL" ]]    && doctor_args+=(--builder-model "$OV_BUILDER_MODEL")
  [[ -n "$OV_BUILDER_EFFORT" ]]   && doctor_args+=(--builder-effort "$OV_BUILDER_EFFORT")
  [[ -n "$OV_BUILDER_AUTONOMY" ]] && doctor_args+=(--builder-autonomy "$OV_BUILDER_AUTONOMY")
  [[ -n "$OV_REVIEWER_KIND" ]]    && doctor_args+=(--reviewer "$OV_REVIEWER_KIND")
  [[ -n "$OV_REVIEWER_MODEL" ]]   && doctor_args+=(--reviewer-model "$OV_REVIEWER_MODEL")
  [[ -n "$OV_REVIEWER_EFFORT" ]]  && doctor_args+=(--reviewer-effort "$OV_REVIEWER_EFFORT")
  doctor_rc=0
  doctor_out=$(tandem doctor "${doctor_args[@]}" 2>&1) || doctor_rc=$?
  # Exit 2 is a usage error, which these flags never cause on a current binary:
  # the installed tandem has no doctor, or no --problems.
  (( doctor_rc != 2 )) \
    || die "the installed tandem is behind these commands (no 'tandem doctor --problems'); re-run install.sh."
  if (( doctor_rc != 0 )); then
    printf '%s\n\n' "$doctor_out" >&2
    printf 'tandem-pair: fix the problems above, or run with --skip-doctor.\n' >&2
    exit "$doctor_rc"
  fi
  [[ -z "$doctor_out" ]] || printf '%s\n\n' "$doctor_out" >&2
fi

# --- resolve the launch spec ---
# tandem maps the settings to each CLI's flags and refuses values with no
# faithful equivalent.

BUILDER_ARGS=()
resolve_launch_args builder BUILDER_ARGS
BUILDER_KIND="$LAUNCH_KIND"
[[ -n "$BUILDER_KIND" ]] || die "launch spec carried no kind."
resolve_reviewer

# --- name the planner ---
if [[ "$PLANNER_CURRENT_NAME" == "$PLANNER_NAME" ]]; then
  info "planner already named '$PLANNER_NAME'."
else
  clash=""; rc=0
  _snap=$(tandem agent snapshot "$PLANNER_NAME" 2>/dev/null) || rc=$?
  if (( rc == 0 )); then
    IFS=$'\t' read -r clash _ _ <<<"$_snap"
    [[ "$clash" == "$PLANNER_PANE" ]] && clash=""
  elif (( rc != 10 )); then
    die "could not check whether '$PLANNER_NAME' is already in use."
  fi
  [[ -z "$clash" ]] || die "the name '$PLANNER_NAME' is already held by pane $clash. Release it or set HERDR_PLANNER_NAME."
  mutate agent rename "$PLANNER_PANE" "$PLANNER_NAME" \
    || die "could not name the planner: $(printf '%s' "$MUTATE_ERR" | cut -f2-)"
  info "named planner agent '$PLANNER_NAME'."
fi

ensure_builder
ensure_reviewer
label_panes
resolve_bcwd
record_builder
record_reviewer
start_bridge

printf '\n'
info "pair ready: planner $PLANNER_PANE, builder $BUILDER_PANE${REVIEWER_PANE:+, reviewer $REVIEWER_PANE}."
info "hand over a plan with: tandem-handoff"
info "close the session with:  tandem-unpair"
