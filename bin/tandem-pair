#!/usr/bin/env bash
# tandem-pair: establish or repair the planner, builder and reviewer panes.
#
# Idempotent. It adopts agents that are already running, so it can repair a
# half-set-up session. See README.md.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/reviewer.sh
. "${_self%/*}/lib/reviewer.sh"

PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"
BUILDER_NAME="${HERDR_BUILDER_NAME:-builder}"
REVIEWER_NAME="${HERDR_REVIEWER_NAME:-reviewer}"
PLANNER_KIND="claude"
START_TIMEOUT_MS="${HERDR_PAIR_START_TIMEOUT_MS:-60000}"

DRY_RUN=0
SKIP_DOCTOR=0
DIRECTION=""
PLANNER_PANE=""
CWD_OVERRIDE=""
OV_BUILDER_KIND=""
OV_BUILDER_MODEL=""
OV_BUILDER_EFFORT=""
OV_BUILDER_AUTONOMY=""
# A space-separated string, because bash 3.2 treats an empty array as unset
# under set -u.
OV_APPROVE_KINDS=""
OV_REVIEWER_KIND=""
OV_REVIEWER_MODEL=""
OV_REVIEWER_EFFORT=""

usage() {
  cat <<'USAGE'
usage: tandem-pair [--dry-run] [--direction right|down] [--planner-pane ID]

Names the Claude agent "planner", ensures a sibling Codex pane named "builder",
and tags both panes with a role token for the Herdr sidebar.

  --dry-run           print the mutating herdr calls without making them
  --skip-doctor       pair without running `tandem doctor` first
  --direction DIR     force split direction (default: derived from pane shape)
  --planner-pane ID   use this pane as the planner (default: auto-detected)
  --cwd PATH          working directory for the builder pane. Defaults to the
                      planner's own cwd, which is not always the repo you mean.
  --builder KIND      agent CLI for the builder (codex|claude|copilot|opencode)
  --builder-model M   model override for the builder
  --builder-effort E  effort override (low|medium|high|max)
  --builder-autonomy A
                      autonomy override (readonly|ask|auto|full)
  --approve-kind K    approve a kind requested by this repository, then pair.
                      Repeat it to approve the builder's and the reviewer's
                      kinds in one run
  --reviewer KIND     the agent CLI for the reviewer, overriding the "reviewer"
                      block in .tandem.json. Every review is sent to
                      the reviewer pane, never to the builder, so the builder
                      can run a cheap model and the review a strong one. It is
                      never the builder or the planner.
  --reviewer-model M  model for the reviewer (overrides .tandem.json)
  --reviewer-effort E effort for the reviewer (overrides .tandem.json)

The reviewer is started when .tandem.json has a "reviewer" block
with a kind, or --reviewer is given. With neither, the pair is made without
one and review and build will refuse until one is configured.
USAGE
}

die()  { printf 'tandem-pair: %s\n' "$*" >&2; exit 1; }
info() { printf 'tandem-pair: %s\n' "$*"; }

# mutate <args...>: a state-changing herdr call, skipped under --dry-run.
MUTATE_OUT=""; MUTATE_ERR=""
mutate() {
  if (( DRY_RUN )); then
    printf '  [dry-run] herdr %s\n' "$*"
    MUTATE_OUT=""; MUTATE_ERR=""
    return 0
  fi
  local rc=0
  MUTATE_OUT=$(tandem "$@" 2>&1) || rc=$?
  if (( rc != 0 )); then
    MUTATE_ERR="$MUTATE_OUT"
    MUTATE_OUT=""
  else
    MUTATE_ERR=""
  fi
  return "$rc"
}

# ensure_relay_ignored <repo-root>: keep the mailbox out of version control.
# tandem-pair creates the mailbox, so it ignores it even when tandem-init never
# ran. Keep this identical to the copy in tandem-init.
ensure_relay_ignored() {
  local root="$1" gi="$1/.gitignore" base re
  git -C "$root" rev-parse --git-dir >/dev/null 2>&1 || return 0
  # tandem resolves the name, so a repo with the legacy .herdr-relay gets that
  # name ignored.
  base=$(tandem paths relay --root "$root") || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
  base=$(basename "$base")
  re="^/?${base//./\\.}/?$"
  if [[ -f "$gi" ]] && grep -qE "$re" "$gi"; then
    return 0
  fi
  # The leading newline ends a final .gitignore line that lacks one.
  if printf '\n# tandem agent relay mailbox (local IPC, never committed)\n%s/\n' "$base" >> "$gi"; then
    info "added $base/ to $gi"
  else
    info "WARNING could not write $gi; $base will show up as untracked."
  fi
}

# prelaunch_gates <kind> [role]: run and report the pre-launch gates for an
# unattended agent. The registry decides which gates apply. Exit 23 means the
# agent would stall at a dialog.
prelaunch_gates() {
  local kind="$1" role="${2:-builder}" user_kind="${3:-}" pre_rc=0 dry_arg="" show=new g st d r
  PRE_ERR=$(mktemp)
  (( DRY_RUN )) && dry_arg="--dry-run"
  # Doctor already reported the gates that warn, need a human or lack their
  # tool. It runs the gates dry, so only a gate that acted, or failed to write,
  # is new. Without doctor, every gate that is not current is reported.
  (( SKIP_DOCTOR )) && show=all
  tandem agent prelaunch --role "$role" --kind "$kind" \
    --root "$ROOT" --cwd "$SPLIT_CWD" --user-kind "$user_kind" ${dry_arg:+$dry_arg} \
    --fields --show "$show" >"$FIELDS" 2>"$PRE_ERR" || pre_rc=$?

  # Warnings are not fatal, so the stderr block below does not print them.
  while IFS= read -r -d '' g && IFS= read -r -d '' st && IFS= read -r -d '' d && IFS= read -r -d '' r; do
    info "  $g: $st — $d"
    [[ -z "$r" ]] || info "         $r"
  done < "$FIELDS"

  if (( pre_rc != 0 )); then
    [[ -s "$PRE_ERR" ]] && cat "$PRE_ERR" >&2
    if [[ "${HERDR_SKIP_HOOK_CHECK:-}" == 1 ]]; then
      info "pre-launch gate overridden (HERDR_SKIP_HOOK_CHECK=1)."
    else
      exit "$pre_rc"
    fi
  fi
  rm -f "$PRE_ERR"
  return 0
}

# start_in_pane <name> <kind> <pane> [agent args...]: start an agent in a pane
# that was just split. Sets START_RC, START_CODE and START_MSG.
#
# `agent start` needs the pane's shell at its prompt, which takes a moment
# after the split, so retry "not an available shell".
START_RC=0; START_CODE=""; START_MSG=""
start_in_pane() {
  local name="$1" kind="$2" pane="$3" attempt err
  shift 3
  tandem pane wait-shell "$pane" --timeout 10000 >/dev/null 2>&1 || true

  START_RC=1
  for attempt in $(seq 1 2); do
    err=""; START_CODE=""; START_MSG=""; START_RC=0
    err=$(tandem agent start "$name" --kind "$kind" --pane "$pane" \
         --timeout "$START_TIMEOUT_MS" -- "$@" 2>&1 >/dev/null) || START_RC=$?
    IFS=$'\t' read -r START_CODE START_MSG <<<"$err"
    if (( START_RC == 0 )); then
      break
    fi
    case "$START_MSG" in
      *"not an available shell"*)
        (( attempt == 1 )) && info "pane not at its prompt yet; retrying..."
        sleep 1 ;;
      *) break ;;
    esac
  done
  return 0
}

# check_alive NAME ROLE: a CLI can exit seconds after it starts.
# `tandem agent alive` watches it briefly and reports why it died.
check_alive() {
  local name="$1" role="$2" out rc=0
  out=$(tandem agent alive "$name" 2>&1) || rc=$?
  (( rc == 0 )) && return 0
  printf 'tandem-pair: the %s quit right after it started, so the pair is not ready.\n\n' "$role" >&2
  printf '%s\n' "$out" | tail -n +2 | sed 's/^/    /' >&2
  printf '\n  Fix what the pane shows, then re-run tandem-pair.\n' >&2
  exit 1
}

while (( $# )); do
  case "$1" in
    --dry-run)      DRY_RUN=1; shift ;;
    --skip-doctor)  SKIP_DOCTOR=1; shift ;;
    --direction)    DIRECTION="${2:-}"; shift 2 ;;
    --planner-pane) PLANNER_PANE="${2:-}"; shift 2 ;;
    --cwd)          CWD_OVERRIDE="${2:-}"; shift 2 ;;
    --builder)           OV_BUILDER_KIND="${2:-}";     shift 2 ;;
    --builder-model)     OV_BUILDER_MODEL="${2:-}";    shift 2 ;;
    --builder-effort)    OV_BUILDER_EFFORT="${2:-}";   shift 2 ;;
    --builder-autonomy)  OV_BUILDER_AUTONOMY="${2:-}"; shift 2 ;;
    --approve-kind)       OV_APPROVE_KINDS="$OV_APPROVE_KINDS ${2:-}"; shift 2 ;;
    --reviewer)          OV_REVIEWER_KIND="${2:-}";    shift 2 ;;
    --reviewer-model)    OV_REVIEWER_MODEL="${2:-}";   shift 2 ;;
    --reviewer-effort)   OV_REVIEWER_EFFORT="${2:-}";  shift 2 ;;
    -h|--help)      usage; exit 0 ;;
    *)              usage >&2; die "unknown argument: $1" ;;
  esac
done

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
command -v tandem >/dev/null 2>&1 || die "tandem not found on PATH."
[[ -z "$DIRECTION" || "$DIRECTION" == right || "$DIRECTION" == down ]] \
  || die "--direction must be right or down (got: $DIRECTION)."
[[ -z "$CWD_OVERRIDE" || -d "$CWD_OVERRIDE" ]] || die "--cwd is not a directory: $CWD_OVERRIDE"
[[ "$REVIEWER_NAME" != "$BUILDER_NAME" && "$REVIEWER_NAME" != "$PLANNER_NAME" ]] \
  || die "the reviewer cannot be named '$REVIEWER_NAME': that is the builder or the planner, which would review its own work."

# Go writes NUL-separated fields here, which a bash variable cannot hold.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS" "${PRE_ERR:-}"' EXIT

# read_resolve: read `tandem config resolve --fields` from $FIELDS into R_*.
read_resolve() {
  R_STATUS=""; R_REASON=""; R_KIND=""; R_MODEL=""; R_EFFORT=""; R_AUTONOMY=""
  R_KIND_FROM=""; R_MODEL_FROM=""; R_EFFORT_FROM=""; R_AUTONOMY_FROM=""; R_UNENFORCED=""
  { IFS= read -r -d '' R_STATUS; IFS= read -r -d '' R_REASON; IFS= read -r -d '' R_KIND
    IFS= read -r -d '' R_MODEL; IFS= read -r -d '' R_EFFORT; IFS= read -r -d '' R_AUTONOMY
    IFS= read -r -d '' R_KIND_FROM; IFS= read -r -d '' R_MODEL_FROM; IFS= read -r -d '' R_EFFORT_FROM
    IFS= read -r -d '' R_AUTONOMY_FROM; IFS= read -r -d '' R_UNENFORCED; } < "$FIELDS" || true
}

# --- resolve the planner pane ---
# Order: explicit flag, the calling pane, the only claude agent. From a popup,
# $HERDR_PANE_ID is the popup's pane, not the planner's.
rc=0
_err=$(tandem agent planner ${PLANNER_PANE:+--pane "$PLANNER_PANE"} --kind "$PLANNER_KIND" 2>&1 >"$FIELDS") || rc=$?
case "$rc" in
  0)
    { IFS= read -r -d '' PLANNER_PANE; IFS= read -r -d '' PLANNER_CWD
      IFS= read -r -d '' PLANNER_TAB; IFS= read -r -d '' PLANNER_CURRENT_NAME; } < "$FIELDS" || true ;;
  31)
    die "no running $PLANNER_KIND agent found. Start Claude Code in a pane first." ;;
  32)
    count=0; _list=""
    while IFS= read -r -d '' _p && IFS= read -r -d '' _n && IFS= read -r -d '' _c; do
      count=$((count + 1))
      _list="$_list  $_p  name=${_n:--}  cwd=${_c:--}"$'\n'
    done < "$FIELDS"
    printf 'tandem-pair: %s %s agents are running; cannot pick one automatically:\n' "$count" "$PLANNER_KIND" >&2
    printf '%s' "$_list" >&2
    die "re-run with --planner-pane <pane_id>." ;;
  *)
    die "could not list agents: $(printf '%s' "$_err" | cut -f2-)" ;;
esac

info "planner pane: $PLANNER_PANE (cwd: ${PLANNER_CWD:-unknown})"

SPLIT_CWD="${CWD_OVERRIDE:-${PLANNER_CWD:-$PWD}}"
ROOT=$(git -C "$SPLIT_CWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$SPLIT_CWD")

for _kind in $OV_APPROVE_KINDS; do
  tandem config approve-kind --root "$ROOT" --kind "$_kind" >/dev/null \
    || die "could not record approval for kind '$_kind'."
done

# --- doctor ---
# Every setup problem at once, before any pane opens. The per-pane gates below
# still run, because the machine can change between the two. A dry run checks
# too: doctor writes nothing. --problems prints only failures and warnings, and
# nothing when every check passes.
if (( ! SKIP_DOCTOR )); then
  doctor_args=(--problems --cwd "$SPLIT_CWD")
  [[ -n "$OV_BUILDER_KIND" ]]     && doctor_args+=(--builder "$OV_BUILDER_KIND")
  [[ -n "$OV_BUILDER_MODEL" ]]    && doctor_args+=(--builder-model "$OV_BUILDER_MODEL")
  [[ -n "$OV_BUILDER_EFFORT" ]]   && doctor_args+=(--builder-effort "$OV_BUILDER_EFFORT")
  [[ -n "$OV_BUILDER_AUTONOMY" ]] && doctor_args+=(--builder-autonomy "$OV_BUILDER_AUTONOMY")
  [[ -n "$OV_REVIEWER_KIND" ]]    && doctor_args+=(--reviewer "$OV_REVIEWER_KIND")
  [[ -n "$OV_REVIEWER_MODEL" ]]   && doctor_args+=(--reviewer-model "$OV_REVIEWER_MODEL")
  [[ -n "$OV_REVIEWER_EFFORT" ]]  && doctor_args+=(--reviewer-effort "$OV_REVIEWER_EFFORT")
  doctor_rc=0
  doctor_out=$(tandem doctor "${doctor_args[@]}" 2>&1) || doctor_rc=$?
  # Exit 2 is a usage error, which these flags never cause on a current binary:
  # the installed tandem has no doctor, or no --problems.
  (( doctor_rc != 2 )) \
    || die "the installed tandem is behind these commands (no 'tandem doctor --problems'); re-run install.sh."
  if (( doctor_rc != 0 )); then
    printf '%s\n\n' "$doctor_out" >&2
    printf 'tandem-pair: fix the problems above, or run with --skip-doctor.\n' >&2
    exit "$doctor_rc"
  fi
  [[ -z "$doctor_out" ]] || printf '%s\n\n' "$doctor_out" >&2
fi

# --- resolve the launch spec ---
# tandem maps the settings to each CLI's flags and refuses values with no
# faithful equivalent.

# resolve_launch_args ROLE OUTVAR: fill array OUTVAR with ROLE's CLI args and
# leave the kind in LAUNCH_KIND. A refusal prints tandem's remedy and exits with
# its code. A dry run skips the sandbox probe.
#
# The args are NUL-delimited so an argument may contain a newline. bash 3.2
# has no mapfile.
resolve_launch_args() {
  local role="$1" outvar="$2" a
  local flags=()
  case "$role" in
    builder)
      flags=(${OV_BUILDER_KIND:+--kind "$OV_BUILDER_KIND"}
             ${OV_BUILDER_MODEL:+--model "$OV_BUILDER_MODEL"}
             ${OV_BUILDER_EFFORT:+--effort "$OV_BUILDER_EFFORT"}
             ${OV_BUILDER_AUTONOMY:+--autonomy "$OV_BUILDER_AUTONOMY"}) ;;
    reviewer)
      flags=(${OV_REVIEWER_KIND:+--kind "$OV_REVIEWER_KIND"}
             ${OV_REVIEWER_MODEL:+--model "$OV_REVIEWER_MODEL"}
             ${OV_REVIEWER_EFFORT:+--effort "$OV_REVIEWER_EFFORT"}) ;;
  esac
  (( DRY_RUN )) && flags+=(--dry-run)
  # A refusal's remedy, and any warning, arrive on stderr as sentences.
  tandem agent launch-spec --role "$role" --root "$ROOT" --cwd "$SPLIT_CWD" --fields \
    ${flags[@]+"${flags[@]}"} >"$FIELDS" || exit $?
  LAUNCH_KIND=""
  eval "$outvar=()"
  { IFS= read -r -d '' LAUNCH_KIND
    while IFS= read -r -d '' a; do
      eval "$outvar+=(\"\$a\")"
    done; } < "$FIELDS"
}

BUILDER_ARGS=()
resolve_launch_args builder BUILDER_ARGS
BUILDER_KIND="$LAUNCH_KIND"
[[ -n "$BUILDER_KIND" ]] || die "launch spec carried no kind."

# --- resolve the reviewer ---
# The reviewer has its own settings and never inherits the builder's. It is
# resolved before any pane changes, so a bad reviewer stops the pairing early.
# `tandem config resolve` reports none, resolved or invalid, and exits 0.
REVIEWER_PANE=""; REVIEWER_KIND=""; REVIEWER_LAUNCH=0; REVIEWER_ARGS=()
REVIEWER_MODEL=""; REVIEWER_EFFORT=""; REVIEWER_AUTONOMY=""
tandem config resolve --role reviewer --root "$ROOT" --cwd "$SPLIT_CWD" --fields \
  ${OV_REVIEWER_KIND:+--kind "$OV_REVIEWER_KIND"} \
  ${OV_REVIEWER_MODEL:+--model "$OV_REVIEWER_MODEL"} \
  ${OV_REVIEWER_EFFORT:+--effort "$OV_REVIEWER_EFFORT"} \
  >"$FIELDS" 2>/dev/null || die "could not resolve the reviewer."
read_resolve
case "$R_STATUS" in
  resolved)
    REVIEWER_KIND="$R_KIND"; REVIEWER_MODEL="$R_MODEL"
    REVIEWER_EFFORT="$R_EFFORT"; REVIEWER_AUTONOMY="$R_AUTONOMY"
    REVIEWER_FROM="$R_KIND_FROM $R_MODEL_FROM $R_EFFORT_FROM $R_AUTONOMY_FROM"
    [[ -n "$REVIEWER_KIND" ]] || die "the resolved reviewer carried no kind."
    ;;
  invalid)
    die "${R_REASON:-the reviewer configuration is invalid.}"
    ;;
  none)
    [[ -z "$OV_REVIEWER_MODEL$OV_REVIEWER_EFFORT" ]] \
      || die "--reviewer-model and --reviewer-effort need a reviewer. $REVIEWER_REMEDY"
    info "WARNING no reviewer is configured, so review and build will refuse until one is. $REVIEWER_REMEDY"
    ;;
  *)
    die "could not read the reviewer configuration."
    ;;
esac

if [[ -n "$REVIEWER_KIND" ]]; then
  rc=0
  _snap=$(tandem agent snapshot "$REVIEWER_NAME" 2>/dev/null) || rc=$?
  if (( rc == 0 )); then
    IFS=$'\t' read -r REVIEWER_PANE _ _ <<<"$_snap"
  elif (( rc != 10 )); then
    die "could not check for an existing reviewer."
  fi
  if [[ -z "$REVIEWER_PANE" ]]; then
    # Only a reviewer about to start needs a launch spec. Approval (exit 22) and
    # refusals are handled as for the builder.
    REVIEWER_LAUNCH=1
    resolve_launch_args reviewer REVIEWER_ARGS
    if (( DRY_RUN )); then
      read -r _kf _mf _ef _af <<<"$REVIEWER_FROM"
      printf '  [dry-run] would start the reviewer: kind %s (%s), model %s (%s), effort %s (%s), autonomy %s (%s)\n' \
        "${REVIEWER_KIND:-default}" "$_kf" "${REVIEWER_MODEL:-default}" "$_mf" \
        "${REVIEWER_EFFORT:-default}" "$_ef" "${REVIEWER_AUTONOMY:-default}" "$_af"
    fi
  fi
fi

# --- name the planner ---
if [[ "$PLANNER_CURRENT_NAME" == "$PLANNER_NAME" ]]; then
  info "planner already named '$PLANNER_NAME'."
else
  clash=""; rc=0
  _snap=$(tandem agent snapshot "$PLANNER_NAME" 2>/dev/null) || rc=$?
  if (( rc == 0 )); then
    IFS=$'\t' read -r clash _ _ <<<"$_snap"
    [[ "$clash" == "$PLANNER_PANE" ]] && clash=""
  elif (( rc != 10 )); then
    die "could not check whether '$PLANNER_NAME' is already in use."
  fi
  [[ -z "$clash" ]] || die "the name '$PLANNER_NAME' is already held by pane $clash. Release it or set HERDR_PLANNER_NAME."
  mutate agent rename "$PLANNER_PANE" "$PLANNER_NAME" \
    || die "could not name the planner: $(printf '%s' "$MUTATE_ERR" | cut -f2-)"
  info "named planner agent '$PLANNER_NAME'."
fi

# --- ensure the builder ---
BUILDER_PANE=""; rc=0
_snap=$(tandem agent snapshot "$BUILDER_NAME" 2>/dev/null) || rc=$?
if (( rc == 0 )); then
  IFS=$'\t' read -r BUILDER_PANE _ _ <<<"$_snap"
elif (( rc != 10 )); then
  die "could not check for an existing builder."
fi

if [[ -n "$BUILDER_PANE" ]]; then
  info "builder already present in pane $BUILDER_PANE."
else
  # Adopt the single unnamed agent in the planner's tab, whatever its kind, so a
  # config change does not start a second one. --builder KIND narrows it. A dry
  # run leaves the planner unnamed, so exclude it by pane id.
  ADOPTED_KIND=""
  tandem agent adoptable --exclude-pane "$PLANNER_PANE" ${PLANNER_TAB:+--tab "$PLANNER_TAB"} \
    ${OV_BUILDER_KIND:+--kind "$OV_BUILDER_KIND"} >"$FIELDS" 2>/dev/null \
    || die "could not list agents to look for one to adopt."
  { IFS= read -r -d '' BUILDER_PANE; IFS= read -r -d '' ADOPTED_KIND; } < "$FIELDS" || true

  if [[ -n "$BUILDER_PANE" ]]; then
    info "adopting the running $ADOPTED_KIND agent in pane $BUILDER_PANE."
    tandem config resolve --role builder --root "$ROOT" --adopted "$ADOPTED_KIND" --fields \
      >"$FIELDS" 2>/dev/null || : >"$FIELDS"
    read_resolve
    _un="$R_UNENFORCED"
    if [[ -n "$_un" ]]; then
      info "         config declares $_un"
      info "         These are UNENFORCED on an adopted agent — it keeps the"
      info "         settings it was started with. Restart the pane to apply them."
    fi
    mutate agent rename "$BUILDER_PANE" "$BUILDER_NAME" \
      || die "could not name the builder: $(printf '%s' "$MUTATE_ERR" | cut -f2-)"
  else
    # Split a wide pane to the right, a narrow or tall pane down.
    if [[ -z "$DIRECTION" ]]; then
      if tandem pane split-direction "$PLANNER_PANE" >"$FIELDS" 2>/dev/null \
        && { IFS= read -r -d '' DIRECTION && IFS= read -r -d '' pw && IFS= read -r -d '' ph; } < "$FIELDS"; then
        info "pane is ${pw}x${ph} cells; splitting $DIRECTION."
      else
        DIRECTION=right
      fi
    fi

    prelaunch_gates "$BUILDER_KIND" builder "$OV_BUILDER_KIND"
    # HERDR_ROLE lets the builder find its own name in mailbox mode, where it
    # cannot reach the socket.
    mutate pane split "$PLANNER_PANE" --direction "$DIRECTION" --cwd "$SPLIT_CWD" \
      --env "HERDR_ROLE=$BUILDER_NAME" --no-focus \
      || die "could not split the planner pane: $(printf '%s' "$MUTATE_ERR" | cut -f2-)"

    if (( DRY_RUN )); then
      # Dry run does not split, so there is no real pane id.
      BUILDER_PANE="<id assigned by the split above>"
      printf '  [dry-run] herdr agent start %s --kind %s --pane %s --timeout %s -- %s\n' \
        "$BUILDER_NAME" "$BUILDER_KIND" "$BUILDER_PANE" "$START_TIMEOUT_MS" "${BUILDER_ARGS[*]}"
    else
      BUILDER_PANE="$MUTATE_OUT"
      [[ -n "$BUILDER_PANE" ]] || die "split succeeded but returned no pane id."
      info "created pane $BUILDER_PANE (cwd: $SPLIT_CWD)."

      start_in_pane "$BUILDER_NAME" "$BUILDER_KIND" "$BUILDER_PANE" ${BUILDER_ARGS+"${BUILDER_ARGS[@]}"}

      if (( START_RC != 0 )); then
        # agent_not_ready means the agent is blocked during startup but its name
        # resolves, so only warn.
        if [[ "$START_CODE" == "agent_not_ready" ]]; then
          info "WARNING: $BUILDER_KIND started but is not ready yet (likely an approval prompt)."
          info "         Check pane $BUILDER_PANE before sending it work."
        else
          die "could not start $BUILDER_KIND: ${START_MSG:-unknown error}"
        fi
      else
        check_alive "$BUILDER_NAME" builder
        info "started $BUILDER_KIND as '$BUILDER_NAME' in pane $BUILDER_PANE."
      fi
    fi
  fi
fi

# --- ensure the reviewer ---
# Review prompts go to this pane, so the builder can run a cheap model and the
# reviewer a strong one. It gets the builder's launch rules with its own kind,
# model and effort, and is never reset.
REVIEWER_STARTED=0
if [[ -n "$REVIEWER_KIND" ]]; then
  [[ -z "$REVIEWER_PANE" || ( "$REVIEWER_PANE" != "$PLANNER_PANE" && "$REVIEWER_PANE" != "$BUILDER_PANE" ) ]] \
    || die "the agent named '$REVIEWER_NAME' is the planner's or the builder's pane; it cannot review."

  if (( ! REVIEWER_LAUNCH )); then
    # A running reviewer keeps the kind and model it was started with.
    _running=$(tandem agent kind "$REVIEWER_NAME" 2>/dev/null) || _running=""
    info "reviewer already present in pane $REVIEWER_PANE."
    if [[ -n "$_running" && "$_running" != "$REVIEWER_KIND" ]]; then
      info "         it runs $_running, not $REVIEWER_KIND. Close it and re-pair to change it."
      REVIEWER_KIND="$_running"
    fi
    [[ -z "$OV_REVIEWER_MODEL$OV_REVIEWER_EFFORT" ]] \
      || info "         --reviewer-model and --reviewer-effort are UNENFORCED on a running reviewer."
  else
    REVIEWER_STARTED=1
    prelaunch_gates "$REVIEWER_KIND" reviewer "$OV_REVIEWER_KIND"
    mutate pane split "$BUILDER_PANE" --direction down --cwd "$SPLIT_CWD" \
      --env "HERDR_ROLE=$REVIEWER_NAME" --no-focus \
      || die "could not split the builder pane for the reviewer: $(printf '%s' "$MUTATE_ERR" | cut -f2-)"
    if (( DRY_RUN )); then
      REVIEWER_PANE="<id assigned by the reviewer split above>"
      printf '  [dry-run] herdr agent start %s --kind %s --pane %s --timeout %s -- %s\n' \
        "$REVIEWER_NAME" "$REVIEWER_KIND" "$REVIEWER_PANE" "$START_TIMEOUT_MS" "${REVIEWER_ARGS[*]}"
    else
      REVIEWER_PANE="$MUTATE_OUT"
      [[ -n "$REVIEWER_PANE" ]] || die "split succeeded but returned no pane id for the reviewer."
      info "created pane $REVIEWER_PANE for the reviewer."
      start_in_pane "$REVIEWER_NAME" "$REVIEWER_KIND" "$REVIEWER_PANE" ${REVIEWER_ARGS+"${REVIEWER_ARGS[@]}"}
      if (( START_RC != 0 )); then
        if [[ "$START_CODE" == "agent_not_ready" ]]; then
          info "WARNING: $REVIEWER_KIND started but is not ready yet (likely an approval prompt)."
          info "         Check pane $REVIEWER_PANE before a review is sent to it."
        else
          die "could not start the $REVIEWER_KIND reviewer: ${START_MSG:-unknown error}"
        fi
      else
        check_alive "$REVIEWER_NAME" reviewer
        info "started $REVIEWER_KIND as '$REVIEWER_NAME' in pane $REVIEWER_PANE."
      fi
    fi
  fi
fi

# --- role tokens for the sidebar ---
mutate pane report-metadata "$PLANNER_PANE" --source tandem-pair --token role=PLAN  || true
mutate pane report-metadata "$BUILDER_PANE" --source tandem-pair --token role=BUILD || true
if [[ -n "$REVIEWER_PANE" ]]; then
  mutate pane report-metadata "$REVIEWER_PANE" --source tandem-pair --token role=REVIEW || true
fi

# --- pane and tab labels ---
# Best-effort. The tab is renamed only while it still has Herdr's default
# number, so a name someone chose is kept.
mutate pane rename "$PLANNER_PANE" "planner ($PLANNER_KIND)" || true
mutate pane rename "$BUILDER_PANE" "builder (${ADOPTED_KIND:-$BUILDER_KIND})" || true
if [[ -n "$REVIEWER_PANE" ]]; then
  mutate pane rename "$REVIEWER_PANE" "reviewer ($REVIEWER_KIND)" || true
fi
if [[ -n "$PLANNER_TAB" ]]; then
  if [[ "$(tandem tab label "$PLANNER_TAB" 2>/dev/null)" == default ]]; then
    mutate tab rename "$PLANNER_TAB" "tandem: $(basename "$ROOT")" || true
  fi
fi

# --- resolve the builder pane's own cwd ---
# builder.json must be written where its readers look: tandem-handoff uses the
# pane's cwd from `agent snapshot` and tandem-verdict uses its own $PWD. The
# split cwd can differ, for an adopted agent or a planner in a subdirectory.
# BCWD is not walked to the git toplevel, because neither reader walks.
BCWD=""; MB_ROOT=""
if ! (( DRY_RUN )); then
  rc=0
  _snap=$(tandem agent snapshot "$BUILDER_NAME" 2>/dev/null) || rc=$?
  if (( rc == 0 )); then
    IFS=$'\t' read -r _ BCWD _ <<<"$_snap"
  fi
  BCWD="${BCWD:-${CWD_OVERRIDE:-$PWD}}"
  # MB_ROOT is the git toplevel, used only by the relay bridge.
  MB_ROOT=$(git -C "$BCWD" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$BCWD")
fi

# --- record the builder's identity ---
# One record that tandem-verdict and the gate read, so they never resolve the
# values again and disagree. It is resolved with the same override flags as the
# launch spec. For an adopted builder it records what tandem asked for, which
# may differ from how the agent was started (see guide/refusals.md). A dry run resolves
# it too, to show the record a real run would write. tandem refuses an empty
# kind or autonomy, which the gate would refuse every review on.
IDENTITY_MAILBOX=""
if (( ! DRY_RUN )); then
  # A separate name from MAILBOX, because the bridge's mailbox comes from the
  # walked root and can differ.
  IDENTITY_MAILBOX=$(tandem paths relay --root "$BCWD" 2>/dev/null) \
    || die "could not resolve the relay mailbox to record the builder identity."
fi
_dry=""; (( DRY_RUN )) && _dry=--dry-run
tandem config record-builder ${IDENTITY_MAILBOX:+--relay "$IDENTITY_MAILBOX"} ${_dry:+$_dry} \
  --root "$ROOT" --cwd "$SPLIT_CWD" \
  ${OV_BUILDER_KIND:+--kind "$OV_BUILDER_KIND"} \
  ${OV_BUILDER_MODEL:+--model "$OV_BUILDER_MODEL"} \
  ${OV_BUILDER_EFFORT:+--effort "$OV_BUILDER_EFFORT"} \
  ${OV_BUILDER_AUTONOMY:+--autonomy "$OV_BUILDER_AUTONOMY"} \
  ${ADOPTED_KIND:+--adopted "$ADOPTED_KIND"} \
  >"$FIELDS" || die "could not record the builder identity${IDENTITY_MAILBOX:+ in $IDENTITY_MAILBOX}."
{ IFS= read -r -d '' _kind; IFS= read -r -d '' _autonomy; IFS= read -r -d '' IDENTITY; } < "$FIELDS" || true

if (( DRY_RUN )); then
  printf '  [dry-run] would record builder identity: %s\n' "$IDENTITY"
else
  info "recorded builder identity: $_kind/$_autonomy"
fi

# --- record the reviewer ---
# Written beside builder.json. A pair with no reviewer leaves an earlier record
# alone. model_measured says whether the launch model is known: a reviewer
# started here has it, a running one keeps the earlier record only for the same
# name and kind (config.NextReviewer).
if [[ -n "$REVIEWER_PANE" ]]; then
  _rrelay="${IDENTITY_MAILBOX:-$(tandem paths relay --root "${BCWD:-$SPLIT_CWD}")}"
  _rargs=(--relay "$_rrelay" --kind "$REVIEWER_KIND" --name "$REVIEWER_NAME" --autonomy "$REVIEWER_AUTONOMY")
  (( REVIEWER_STARTED )) && _rargs+=(--started --model "$REVIEWER_MODEL")
  (( DRY_RUN )) && _rargs+=(--dry-run)
  tandem reviewer record "${_rargs[@]}" >"$FIELDS" \
    || die "could not record the reviewer in $_rrelay/reviewer.json"
  { IFS= read -r -d '' _rmodel; IFS= read -r -d '' REVIEWER_REC; } < "$FIELDS" || true
  if (( ! REVIEWER_STARTED )); then
    # A running reviewer keeps its settings, so warn when the resolved values
    # differ. Effort is not recorded, so a declared effort is always reported.
    if [[ -n "$REVIEWER_MODEL" && "$REVIEWER_MODEL" != "$_rmodel" ]]; then
      info "         declared reviewer model '$REVIEWER_MODEL' is UNENFORCED on a running reviewer${_rmodel:+ (it was started with '$_rmodel')}. Close it and re-pair to apply it."
    fi
    if [[ -n "$REVIEWER_EFFORT" ]]; then
      info "         declared reviewer effort '$REVIEWER_EFFORT' is UNENFORCED on a running reviewer. Close it and re-pair to apply it."
    fi
  fi
  if (( DRY_RUN )); then
    printf '  [dry-run] would record reviewer: %s\n' "$REVIEWER_REC"
  else
    info "recorded reviewer: $REVIEWER_KIND as '$REVIEWER_NAME'${_rmodel:+ on $_rmodel}"
  fi
fi

# --- relay bridge ---
# Codex's sandbox denies the Herdr socket, so this unsandboxed watcher
# delivers its questions.
if (( ! DRY_RUN )); then
  MAILBOX=$(tandem paths relay --root "$MB_ROOT") \
    || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
  mkdir -p "$MAILBOX/q" "$MAILBOX/a"
  ensure_relay_ignored "$MB_ROOT"

  # Record the builder's cwd in the walked mailbox, so tandem-unpair can find the
  # identity mailbox after the builder pane is gone. It stores the path, not the
  # mailbox, so unpair re-resolves it before its rm -rf guard.
  printf '%s\n' "$BCWD" > "$MAILBOX/builder-cwd.tmp" \
    && mv "$MAILBOX/builder-cwd.tmp" "$MAILBOX/builder-cwd" \
    || info "WARNING could not record the builder cwd in $MAILBOX/builder-cwd; tandem-unpair may leave the identity mailbox behind."

  BRIDGE_PID_FILE="$MAILBOX/bridge.pid"
  if [[ -f "$BRIDGE_PID_FILE" ]] && kill -0 "$(cat "$BRIDGE_PID_FILE" 2>/dev/null)" 2>/dev/null; then
    info "relay bridge already running (pid $(cat "$BRIDGE_PID_FILE"))."
  else
    rm -f "$MAILBOX/bridge.ready"
    nohup tandem-bridge --mailbox "$MAILBOX" --planner "$PLANNER_NAME" \
      >>"$MAILBOX/bridge.log" 2>&1 &
    echo $! > "$BRIDGE_PID_FILE"
    for _ in $(seq 1 50); do [[ -f "$MAILBOX/bridge.ready" ]] && break; kill -0 "$(cat "$BRIDGE_PID_FILE")" 2>/dev/null || break; sleep 0.1; done
    if kill -0 "$(cat "$BRIDGE_PID_FILE")" 2>/dev/null; then
      info "relay bridge started (pid $(cat "$BRIDGE_PID_FILE")) watching $MAILBOX/q"
    else
      info "WARNING relay bridge failed to start; see $MAILBOX/bridge.log"
    fi
  fi
fi

printf '\n'
info "pair ready — planner=$PLANNER_PANE  builder=$BUILDER_PANE${REVIEWER_PANE:+  reviewer=$REVIEWER_PANE}"
info "hand over a plan with: tandem-handoff"
info "close the session with:  tandem-unpair"
