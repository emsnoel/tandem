#!/usr/bin/env bash
# tandem-handoff: hand an implementation plan to the builder agent.
#
# Repo settings come from tandem config project. With no argument, it picks the most
# recently reviewed plan, else the newest plan in the plans directory.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/reviewer.sh
. "${_self%/*}/lib/reviewer.sh"
HANDOFF_LIB="${_self%/*}/lib"
# shellcheck source=lib/handoff-gate.sh
. "$HANDOFF_LIB/handoff-gate.sh"
# shellcheck source=lib/handoff-start.sh
. "$HANDOFF_LIB/handoff-start.sh"
# shellcheck source=lib/handoff-prompt.sh
. "$HANDOFF_LIB/handoff-prompt.sh"
# shellcheck source=lib/handoff-send.sh
. "$HANDOFF_LIB/handoff-send.sh"

BUILDER_NAME="${HERDR_BUILDER_NAME:-builder}"
PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"
PROMPT_TIMEOUT_MS="${HERDR_HANDOFF_TIMEOUT_MS:-120000}"

DRY_RUN=0
WAIT=0
CONTINUE=0
CONTEXT_LIMIT_ARG=""
PLAN_ARG=""
OVERRIDE_ID=""
OVERRIDE_REASON=""
# Set when a --dry-run override would clear the gate, so the main gate call
# does not re-read the sidecar that the dry run left unwritten.
DRY_OVERRIDE_OK=0

usage() {
  cat <<'USAGE'
usage: tandem-handoff [plan-path] [--dry-run] [--wait] [--continue]
                      [--context-limit N]

Sends the builder one task of an implementation plan, in a fresh
conversation. Tandem splits the plan into one brief per task and sends the
next task itself each time the builder hands one back. With no plan-path,
picks the most recently reviewed plan, else the most recently modified file
in the project's plans directory (see tandem-project; configure with .tandem.json / tandem-init). A plan whose
build stopped part-way resumes at its first task that is not done.

  --dry-run   print the plan and prompt without sending anything
  --wait      block until the builder settles (idle/done/blocked)
  --continue  send the next task of the build already running for this
              plan; refuses rather than start a new one (the relay bridge
              uses this)
  --context-limit N
              most bytes of prompt a durable run gives the builder for one
              task. Overrides context_limit in .tandem.json; with neither,
              tandem build start uses its default
  --override-review ID
              proceed despite the objections in review ID
  --because TEXT
              why they are overruled. Required with --override-review, and
              sent to the builder, so write it as a ruling, not a note.
USAGE
}

die()  { printf 'tandem-handoff: %s\n' "$*" >&2; exit 1; }

# Refuse when the relay was written by an engine or protocol this install
# does not understand.
engine_guard() {
  local rc=0
  tandem state engine --root "$1" >/dev/null || rc=$?
  case "$rc" in
    0) ;;
    23) exit 23 ;;
    *) die "the installed tandem cannot check which engine owns this relay (rc $rc); re-run install.sh." ;;
  esac
}
info() { printf 'tandem-handoff: %s\n' "$*"; }

# read_field VAR reads one NUL field from stdin into VAR. It strips trailing
# newlines, as the command substitution these values came through before did,
# so the prompt stays the same.
read_field() {
  local __v=""
  IFS= read -r -d '' __v || true
  while [[ "$__v" == *$'\n' ]]; do __v="${__v%$'\n'}"; done
  printf -v "$1" '%s' "$__v"
}

while (( $# )); do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --wait)    WAIT=1; shift ;;
    --continue) CONTINUE=1; shift ;;
    --context-limit) [[ -n "${2:-}" ]] || die "--context-limit needs a number of bytes."
                     CONTEXT_LIMIT_ARG="$2"; shift 2 ;;
    --override-review) OVERRIDE_ID="${2:-}";     shift 2 ;;
    --because)         OVERRIDE_REASON="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*)        usage >&2; die "unknown option: $1" ;;
    *)         [[ -z "$PLAN_ARG" ]] || die "more than one plan path given."; PLAN_ARG="$1"; shift ;;
  esac
done

[[ -z "$CONTEXT_LIMIT_ARG" || "$CONTEXT_LIMIT_ARG" =~ ^[0-9]+$ ]] \
  || { usage >&2; die "--context-limit takes a number of bytes, not '$CONTEXT_LIMIT_ARG'."; }

# An override with no reason is a usage error. [[:space:]] also catches tabs
# and newlines, and works on bash 3.2.
if [[ -n "$OVERRIDE_ID" && -z "${OVERRIDE_REASON//[[:space:]]/}" ]]; then
  usage >&2
  die "--override-review needs --because. The reason is sent to the builder, which otherwise walks back into the objection it raised."
fi
if [[ -z "$OVERRIDE_ID" && -n "$OVERRIDE_REASON" ]]; then
  usage >&2
  die "--because only means something with --override-review."
fi

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
# tandem answers in NUL-separated fields, which bash reads from a file.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS"' EXIT
for c in herdr tandem tandem-review; do
  command -v "$c" >/dev/null 2>&1 || die "$c not found on PATH."
done

# Pane, cwd and status come from one Herdr read, so they cannot disagree.
# `|| rc=$?` keeps set -e from exiting before the case below. IFS is a tab
# because a cwd may contain spaces.
rc=0
_snap=$(tandem agent snapshot "$BUILDER_NAME" 2>/dev/null) || rc=$?
case $rc in
  0) IFS=$'\t' read -r BUILDER_PANE BUILDER_CWD BUILDER_STATUS <<<"$_snap" ;;
  3)
    cat >&2 <<'MSG'
tandem-handoff: the Herdr socket is unreachable from this shell.

  THE PLAN WAS NOT DELIVERED. Nothing was sent and nothing was queued.

  tandem-handoff is socket-only: it must verify the builder actually left idle,
  and that is a socket call. There is no mailbox path for it, by design.

  Check that the Herdr server is running and that this is a Herdr-managed pane.
  If you are inside an agent sandbox that denies the socket, this command
  cannot work from there. Run it from the planner pane.
MSG
    exit 3 ;;
  *) die "could not find '$BUILDER_NAME'." ;;
esac

# The builder's cwd is the project; $PWD may be a popup's directory.
ROOT="${BUILDER_CWD:-$PWD}"

tandem config project --root "$ROOT" --fields >"$FIELDS" 2>/dev/null \
  || die "could not resolve project settings for $ROOT"
{ read_field ROOT; read_field _plans_dir; read_field CHECK_COMMAND; read_field CONVENTIONS_FILE
  read_field _; read_field PROMPT_EXTRA; read_field TASK_BUDGET; read_field _context_limit
  read_field PROJ_BUILD_ENGINE; read_field REVIEW_DELIVERY; read_field ACCEPTANCE_POLICY
  read_field COLLABORATION; read_field PROJ_SOURCE; read_field _invalid_manifest; } <"$FIELDS"
if [[ -n "$_invalid_manifest" ]]; then
  info "WARNING $_invalid_manifest is not a JSON object, so its settings were ignored."
fi
PLANS_DIR="${HERDR_PLANS_SUBDIR:-$_plans_dir}"
# The per-task prompt limit: the flag, else .tandem.json, else the default.
CONTEXT_LIMIT="${CONTEXT_LIMIT_ARG:-$_context_limit}"
[[ "$CONTEXT_LIMIT" == 0 ]] && CONTEXT_LIMIT=""

# --- resolve the plan ---
if [[ -n "$PLAN_ARG" ]]; then
  PLAN="$PLAN_ARG"
  [[ -f "$PLAN" ]] || die "plan not found: $PLAN"
elif PLAN=$(tandem gate latest-plan --root "$ROOT" 2>/dev/null) && [[ -n "$PLAN" ]]; then
  :  # the most recently reviewed plan, wherever it lives
else
  [[ -n "$PLANS_DIR" ]] || die "no plans directory for $ROOT. Run tandem-init there, set plans_dir in .tandem.json, or pass a plan path."
  PDIR="$ROOT/$PLANS_DIR"
  [[ -d "$PDIR" ]] || die "plans directory not found: $PDIR"
  # stat(1) differs: BSD uses -f '%m', GNU uses -c '%Y'.
  if stat -f '%m' . >/dev/null 2>&1; then
    MTIME_ARGS=(-f '%m %N')
  else
    MTIME_ARGS=(-c '%Y %n')
  fi
  PLAN=$(find "$PDIR" -maxdepth 1 -type f -name '*.md' -exec stat "${MTIME_ARGS[@]}" {} + 2>/dev/null \
         | sort -rn | head -1 | cut -d' ' -f2-)
  [[ -n "$PLAN" ]] || die "no .md plan files in $PDIR"
fi
PLAN_ABS=$(cd "$(dirname "$PLAN")" && printf '%s/%s' "$(pwd)" "$(basename "$PLAN")")

# --- the review gate ---
# It runs before the builder is touched, so a refusal costs nothing. --dry-run
# runs it too. internal/paths owns the relay name, including the legacy one.
MAILBOX=$(tandem paths relay --root "$ROOT") \
  || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
engine_guard "$ROOT"


record_override
review_gate
adopt_standing_ruling
check_planner
start_build
follow_durable_run
check_task
send_pending_review
build_prompt
send_task
