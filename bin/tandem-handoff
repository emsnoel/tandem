#!/usr/bin/env bash
# tandem-handoff: hand an implementation plan to the builder agent.
#
# Repo settings come from tandem config project. With no argument, it picks the most
# recently reviewed plan, else the newest plan in the plans directory.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/reviewer.sh
. "${_self%/*}/lib/reviewer.sh"

BUILDER_NAME="${HERDR_BUILDER_NAME:-builder}"
PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"
PROMPT_TIMEOUT_MS="${HERDR_HANDOFF_TIMEOUT_MS:-120000}"

DRY_RUN=0
WAIT=0
CONTINUE=0
CONTEXT_LIMIT_ARG=""
PLAN_ARG=""
OVERRIDE_ID=""
OVERRIDE_REASON=""
# Set when a --dry-run override would clear the gate, so the main gate call
# does not re-read the sidecar that the dry run left unwritten.
DRY_OVERRIDE_OK=0

usage() {
  cat <<'USAGE'
usage: tandem-handoff [plan-path] [--dry-run] [--wait] [--continue]
                      [--context-limit N]

Sends the builder one task of an implementation plan, in a fresh
conversation. Tandem splits the plan into one brief per task and sends the
next task itself each time the builder hands one back. With no plan-path,
picks the most recently reviewed plan, else the most recently modified file
in the project's plans directory (see tandem-project; configure with .tandem.json / tandem-init). A plan whose
build stopped part-way resumes at its first task that is not done.

  --dry-run   print the plan and prompt without sending anything
  --wait      block until the builder settles (idle/done/blocked)
  --continue  send the next task of the build already running for this
              plan; refuses rather than start a new one (the relay bridge
              uses this)
  --context-limit N
              most bytes of prompt a durable run gives the builder for one
              task. Overrides context_limit in .tandem.json; with neither,
              tandem build start uses its default
  --override-review ID
              proceed despite the objections in review ID
  --because TEXT
              why they are overruled. Required with --override-review, and
              sent to the builder -- it must read as a ruling, not a note.
USAGE
}

die()  { printf 'tandem-handoff: %s\n' "$*" >&2; exit 1; }

# Refuse when the relay was written by an engine or protocol this install
# does not understand.
engine_guard() {
  local rc=0
  tandem state engine --root "$1" >/dev/null || rc=$?
  case "$rc" in
    0) ;;
    23) exit 23 ;;
    *) die "the installed tandem cannot check which engine owns this relay (rc $rc); re-run install.sh." ;;
  esac
}
info() { printf 'tandem-handoff: %s\n' "$*"; }

# say_reset TOKEN prints the sentence for a reset token, or the raw token
# when this tandem is too old to explain it.
say_reset() {
  local s
  s=$(tandem agent explain-reset "$1" --for build 2>/dev/null) || s=""
  info "${s:-builder conversation: ${1:-no answer}}"
}

# turn_ended_at_once WHAT NOTE [WHO PANE]: `agent prompt --as` exited 26, so the
# turn ended as soon as it started. _pres holds the message and the pane screen.
turn_ended_at_once() {
  cat >&2 <<MSG
tandem-handoff: WARNING the ${3:-builder}'s turn ended as soon as it started, so nothing is working on $1.

  Pane ${4:-$BUILDER_PANE} shows:

$(printf '%s\n' "$_pres" | tail -n +2 | sed 's/^/    /')

  A model the CLI rejects, an expired login or used-up quota looks like this.
  Fix it in that pane (or re-run tandem-pair), then re-run this command. $2
MSG
}

# read_field VAR reads one NUL field from stdin into VAR. It strips trailing
# newlines, as the command substitution these values came through before did,
# so the prompt stays the same.
read_field() {
  local __v=""
  IFS= read -r -d '' __v || true
  while [[ "$__v" == *$'\n' ]]; do __v="${__v%$'\n'}"; done
  printf -v "$1" '%s' "$__v"
}

record_build_session() {
  local s
  s=$(tandem agent session "$BUILDER_NAME" --not "$PRE_SESSION" --timeout 5000 2>/dev/null) || s=""
  # Record which conversation holds this task, so its token use can be read
  # from that conversation's log. --not: Codex's id moves only once the first
  # turn starts.
  tandem build sent --root "$ROOT" --task "$TASK" ${s:+--session "$s"} >/dev/null 2>&1 \
    || info "WARNING could not record task $TASK as sent in the build record."
  [[ -n "$s" ]] || return 0
  # An id that did not move after a reset is still the review's conversation.
  # Recording it would make the next handoff skip a reset it needs.
  if [[ "$RESET" == reset || "$RESET" == sent ]] && [[ "$s" == "$PRE_SESSION" ]]; then
    info "WARNING the builder's session did not change when the build started; it may be carrying the review conversation."
    return 0
  fi
  { printf '%s\n' "$s" > "$MAILBOX/build-session.tmp" && mv "$MAILBOX/build-session.tmp" "$MAILBOX/build-session"; } \
    || info "WARNING could not record $MAILBOX/build-session; a later handoff may reset this build's conversation."
}

# LAUNCH_PROMPT is filled by a sequence of global ${var//{{SLOT}}/value}
# replaces, so a value containing another slot's "{{SLOT}}" text would be
# rewritten by a later pass. Plan names and .tandem.json values are
# repo-controlled, so every value goes through defang_slots first.
#
# Nested braces ("{{{OVERRULED}}}") survive one pass, so this loops to a fixed
# point and refuses input that needs more than DEFANG_MAX_PASSES passes.
#
# defang_slots DEST_VAR VALUE writes with `printf -v`, because `$(...)` would
# strip the trailing newlines the template relies on.
SLOT_NAMES=(PLAN ROOT PLANNER PRELUDE CHECKLINE CHECK TASK TOTAL BRIEF LEDGER JUDGE EXTRA OVERRULED)
DEFANG_MAX_PASSES=64
defang_slots() {
  local __dest="$1" __v="$2" __prev name defanged __i=0
  while :; do
    __prev="$__v"
    for name in "${SLOT_NAMES[@]}"; do
      # The replacement goes through a plain variable. Writing its braces inline
      # inside ${...} leaves a stray backslash on this bash.
      defanged="{$name}"
      __v="${__v//\{\{$name\}\}/$defanged}"
    done
    [[ "$__v" == "$__prev" ]] && break
    __i=$((__i + 1))
    if (( __i > DEFANG_MAX_PASSES )); then
      die "the value for $__dest carries slot markers nested deeper than $DEFANG_MAX_PASSES passes can defang; refusing rather than risk an injected ruling. It begins: ${__v:0:60}"
    fi
  done
  printf -v "$__dest" '%s' "$__v"
}

while (( $# )); do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --wait)    WAIT=1; shift ;;
    --continue) CONTINUE=1; shift ;;
    --context-limit) [[ -n "${2:-}" ]] || die "--context-limit needs a number of bytes."
                     CONTEXT_LIMIT_ARG="$2"; shift 2 ;;
    --override-review) OVERRIDE_ID="${2:-}";     shift 2 ;;
    --because)         OVERRIDE_REASON="${2:-}"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*)        usage >&2; die "unknown option: $1" ;;
    *)         [[ -z "$PLAN_ARG" ]] || die "more than one plan path given."; PLAN_ARG="$1"; shift ;;
  esac
done

[[ -z "$CONTEXT_LIMIT_ARG" || "$CONTEXT_LIMIT_ARG" =~ ^[0-9]+$ ]] \
  || { usage >&2; die "--context-limit takes a number of bytes, not '$CONTEXT_LIMIT_ARG'."; }

# An override with no reason is a usage error. [[:space:]] also catches tabs
# and newlines, and works on bash 3.2.
if [[ -n "$OVERRIDE_ID" && -z "${OVERRIDE_REASON//[[:space:]]/}" ]]; then
  usage >&2
  die "--override-review needs --because. The reason is sent to the builder, which otherwise walks back into the objection it raised."
fi
if [[ -z "$OVERRIDE_ID" && -n "$OVERRIDE_REASON" ]]; then
  usage >&2
  die "--because only means something with --override-review."
fi

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
# tandem answers in NUL-separated fields, which bash reads from a file.
FIELDS=$(mktemp)
trap 'rm -f "$FIELDS"' EXIT
for c in herdr tandem tandem-review; do
  command -v "$c" >/dev/null 2>&1 || die "$c not found on PATH."
done

# Pane, cwd and status come from one Herdr read, so they cannot disagree.
# `|| rc=$?` keeps set -e from exiting before the case below. IFS is a tab
# because a cwd may contain spaces.
rc=0
_snap=$(tandem agent snapshot "$BUILDER_NAME" 2>/dev/null) || rc=$?
case $rc in
  0) IFS=$'\t' read -r BUILDER_PANE BUILDER_CWD BUILDER_STATUS <<<"$_snap" ;;
  3)
    cat >&2 <<'MSG'
tandem-handoff: the Herdr socket is unreachable from this shell.

  THE PLAN WAS NOT DELIVERED. Nothing was sent and nothing was queued.

  tandem-handoff is socket-only: it must verify the builder actually left idle,
  and that is a socket call. There is no mailbox path for it, by design.

  Check that the Herdr server is running and that this is a Herdr-managed pane.
  If you are inside an agent sandbox that denies the socket, this command
  cannot work from there -- run it from the planner pane.
MSG
    exit 3 ;;
  *) die "could not find '$BUILDER_NAME'." ;;
esac

# The builder's cwd is the project; $PWD may be a popup's directory.
ROOT="${BUILDER_CWD:-$PWD}"

tandem config project --root "$ROOT" --fields >"$FIELDS" 2>/dev/null \
  || die "could not resolve project settings for $ROOT"
{ read_field ROOT; read_field _plans_dir; read_field CHECK_COMMAND; read_field CONVENTIONS_FILE
  read_field _; read_field PROMPT_EXTRA; read_field TASK_BUDGET; read_field _context_limit
  read_field PROJ_BUILD_ENGINE; read_field REVIEW_DELIVERY; read_field ACCEPTANCE_POLICY
  read_field COLLABORATION; read_field PROJ_SOURCE; read_field _invalid_manifest; } <"$FIELDS"
if [[ -n "$_invalid_manifest" ]]; then
  info "WARNING $_invalid_manifest is not a JSON object, so its settings were ignored."
fi
PLANS_DIR="${HERDR_PLANS_SUBDIR:-$_plans_dir}"
# The per-task prompt limit: the flag, else .tandem.json, else the default.
CONTEXT_LIMIT="${CONTEXT_LIMIT_ARG:-$_context_limit}"
[[ "$CONTEXT_LIMIT" == 0 ]] && CONTEXT_LIMIT=""

# --- resolve the plan ---
if [[ -n "$PLAN_ARG" ]]; then
  PLAN="$PLAN_ARG"
  [[ -f "$PLAN" ]] || die "plan not found: $PLAN"
elif PLAN=$(tandem gate latest-plan --root "$ROOT" 2>/dev/null) && [[ -n "$PLAN" ]]; then
  :  # the most recently reviewed plan, wherever it lives
else
  [[ -n "$PLANS_DIR" ]] || die "no plans directory for $ROOT. Run tandem-init there, set plans_dir in .tandem.json, or pass a plan path."
  PDIR="$ROOT/$PLANS_DIR"
  [[ -d "$PDIR" ]] || die "plans directory not found: $PDIR"
  # stat(1) differs: BSD uses -f '%m', GNU uses -c '%Y'.
  if stat -f '%m' . >/dev/null 2>&1; then
    MTIME_ARGS=(-f '%m %N')
  else
    MTIME_ARGS=(-c '%Y %n')
  fi
  PLAN=$(find "$PDIR" -maxdepth 1 -type f -name '*.md' -exec stat "${MTIME_ARGS[@]}" {} + 2>/dev/null \
         | sort -rn | head -1 | cut -d' ' -f2-)
  [[ -n "$PLAN" ]] || die "no .md plan files in $PDIR"
fi
PLAN_ABS=$(cd "$(dirname "$PLAN")" && printf '%s/%s' "$(pwd)" "$(basename "$PLAN")")

# --- the review gate ---
# It runs before the builder is touched, so a refusal costs nothing. --dry-run
# runs it too. internal/paths owns the relay name, including the legacy one.
MAILBOX=$(tandem paths relay --root "$ROOT") \
  || die "the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh."
engine_guard "$ROOT"

# The ruling is stored in the review sidecar, so it stands until the plan
# changes. It is written only after the gate confirms the named review is the
# newest, since the gate never reads a superseded one.
if [[ -n "$OVERRIDE_ID" ]]; then
  # Review ids have a fixed shape (minted by bin/tandem-handback) and are used
  # in file paths, so check the shape first.
  [[ "$OVERRIDE_ID" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+-[0-9]+$ ]] \
    || die "--override-review takes a review id like 20260913-101530-4821-19273, not '$OVERRIDE_ID'. See $MAILBOX/reviews/."
  _meta="$MAILBOX/reviews/$OVERRIDE_ID.json"
  [[ -f "$_meta" ]] || die "no review with id $OVERRIDE_ID. Check $MAILBOX/reviews/."

  pre_rc=0
  _pre=$(tandem gate review --plan "$PLAN_ABS" --root "$ROOT" \
           --expect-review "$OVERRIDE_ID" 2>/dev/null) || pre_rc=$?
  # Line 1 is a refusal reason only when the gate refused. On success it is the
  # review id.
  _pre_reason=""
  (( pre_rc == 0 )) || _pre_reason=$(printf '%s' "$_pre" | sed -n '1p')
  if [[ "$_pre_reason" == superseded ]]; then
    _newest=$(printf '%s' "$_pre" | sed -n '2p')
    cat >&2 <<MSG
tandem-handoff: this plan has not cleared review.

  THE PLAN WAS NOT DELIVERED.

  $PLAN_ABS

  A NEWER review exists, so the one you named is no longer the one that
  counts. Nothing was sent and your reason was NOT recorded -- read the
  newer review before overruling it:

      $MAILBOX/reviews/$_newest.md

  Then overrule that one:

      tandem-handoff --override-review $_newest --because "..."
MSG
    exit 24
  fi

  # The pre-check runs the full gate before the reason is written, so a current
  # review with objections reports "objections" here. The ruling is written only
  # for "objections" or a bare pass, and only for an exit code this script
  # understands (0 or 24). Any other result means no review matches this plan or
  # builder, or the binary is too old, so nothing is written and the main gate
  # call below prints the remedy.
  case "$_pre_reason" in
    plan|builder|absent|no_reviewer|builder_review|reviewer)
      printf 'tandem-handoff: the named review is no longer current; the ruling was NOT recorded.\n' >&2
      ;;
    objections|"")
      # An empty reason means the gate passed: either the review is clean or an
      # earlier ruling already cleared it. A ruling against a clean review would
      # record a decision nobody made.
      tandem gate ruling --relay "$MAILBOX" --id "$OVERRIDE_ID" >"$FIELDS" 2>/dev/null || true
      read_field _stored_verdict <"$FIELDS"
      if [[ -z "$_pre_reason" && "${_stored_verdict:-}" == clean ]]; then
        printf 'tandem-handoff: review %s raised no objections, so there is nothing to
' "$OVERRIDE_ID" >&2
        printf '  overrule; the ruling was NOT recorded. Handing the plan over as usual.
' >&2
      elif [[ "$pre_rc" != 0 && "$pre_rc" != 24 ]]; then
        printf 'tandem-handoff: the review gate returned an outcome this script does not\n' >&2
        printf '  understand (rc %s); the ruling was NOT recorded. The installed tandem may\n' "$pre_rc" >&2
        printf '  be behind these commands -- re-run install.sh.\n' >&2
      elif (( DRY_RUN )); then
        # A dry run changes nothing, and this write is the gate's only side effect.
        printf 'tandem-handoff: [dry-run] would record in %s:\n' "$_meta" >&2
        printf '  override_reason: %s\n' "$OVERRIDE_REASON" >&2
        # The skipped write is what the main gate call would accept, so skip that
        # call too and proceed as the override would.
        DRY_OVERRIDE_OK=1
      else
        tandem gate rule --relay "$MAILBOX" --id "$OVERRIDE_ID" --because "$OVERRIDE_REASON" \
          || die "could not record the override in $_meta"
      fi
      ;;
    *)
      printf 'tandem-handoff: the review gate returned an outcome this script does not\n' >&2
      printf '  understand (%s); the ruling was NOT recorded.\n' "$_pre_reason" >&2
      ;;
  esac
fi

rc=0
_gate=""
if (( DRY_RUN )) && (( DRY_OVERRIDE_OK )); then
  info "[dry-run] override of $OVERRIDE_ID would clear the review gate; nothing recorded."
else
  _gate=$(tandem gate review --plan "$PLAN_ABS" --root "$ROOT" 2>/dev/null) || rc=$?
fi
if (( rc != 0 )); then
  # The reason, then the reviewed and current sides, then the review id last.
  GATE_REASON=$(printf '%s\n' "$_gate" | sed -n '1p')
  GATE_ID=$(printf '%s\n' "$_gate" | sed -n '2,$p' | tail -n 1)
  GATE_WAS=$(printf '%s\n' "$_gate" | sed -n '2p')
  GATE_NOW=$(printf '%s\n' "$_gate" | sed -n '3p')
  REVIEW_MD="$MAILBOX/reviews/$GATE_ID.md"

  # Each branch says for itself whether anything was sent.
  printf 'tandem-handoff: this plan has not cleared review.\n\n' >&2
  printf '  THE PLAN WAS NOT DELIVERED.\n\n' >&2
  printf '  %s\n' "$PLAN_ABS" >&2

  # absent, plan and builder all mean no review matches what is about to be
  # built, so request one. Only objections need the planner's decision.
  NEEDS_REVIEW=0
  case "$GATE_REASON" in
    absent)
      printf '\n  No review exists for it.\n' >&2
      NEEDS_REVIEW=1 ;;
    plan)
      printf '\n  The plan has changed since it was reviewed:\n\n' >&2
      diff -u "$MAILBOX/reviews/$GATE_ID.plan.md" "$PLAN_ABS" 2>/dev/null \
        | sed 's/^/      /' >&2 || true
      NEEDS_REVIEW=1 ;;
    no_reviewer)
      printf '\n  This pair has no reviewer, and the builder never reviews, so no\n' >&2
      printf '  review can clear this plan. %s\n' "$REVIEWER_REMEDY" >&2
      printf '  Then hand off again. Nothing was sent.\n' >&2 ;;
    builder_review)
      printf '\n  The review of this plan was written by the builder. The builder\n' >&2
      printf '  never reviews, so it does not count. A reviewer is being asked to\n' >&2
      printf '  review it again.\n' >&2
      NEEDS_REVIEW=1 ;;
    reviewer)
      printf '\n  The reviewer is not the one that reviewed this plan. A review does\n' >&2
      printf '  not survive a change of the reviewer kind or model.\n' >&2
      printf '\n  reviewed by: %s\n' "$GATE_WAS" >&2
      printf '  now:         %s\n' "$GATE_NOW" >&2
      NEEDS_REVIEW=1 ;;
    builder)
      if [[ -f "$MAILBOX/builder.json" ]]; then
        # Only said here: with no record there is no previous builder to compare.
        printf '\n  The builder is not the one that reviewed this plan. A review of\n' >&2
        printf '  what you can DO here does not survive a change of kind or autonomy.\n' >&2
        printf '\n  reviewed as: %s\n' "$GATE_WAS" >&2
        printf '  now:         %s\n' "$GATE_NOW" >&2
        NEEDS_REVIEW=1
      else
        # With no record, a re-review cannot succeed until tandem-pair records the
        # builder again, so say that instead of requesting one.
        printf '\n  No builder identity is recorded at all, so there is nothing to\n' >&2
        printf '  compare against. Run tandem-pair, then hand off again -- requesting\n' >&2
        printf '  a review now would only fail the same way, at tandem-verdict.\n' >&2
      fi
      ;;
    objections)
      printf '\n  Nothing was sent; the builder has not seen this plan.\n\n' >&2
      printf '  review: %s\n\n' "$REVIEW_MD" >&2
      sed -n '1,40p' "$REVIEW_MD" 2>/dev/null | sed 's/^/  /' >&2 || true
      printf '\n  Fix the plan and hand off again -- the review is void once the\n' >&2
      printf '  plan changes, so it will be re-reviewed:\n\n' >&2
      printf '      $EDITOR %s\n' "$PLAN_ABS" >&2
      printf '\n  Or overrule them, saying why. The reason reaches the builder:\n\n' >&2
      printf '      tandem-handoff --override-review %s \\\n' "$GATE_ID" >&2
      printf '        --because "..."\n' >&2 ;;
    *)
      printf '\n  The review gate refused: %s\n' "${GATE_REASON:-unknown}" >&2 ;;
  esac

  if (( NEEDS_REVIEW )); then
    if (( DRY_RUN )); then
      printf '\n  [dry-run] would run: tandem-review %s\n' "$PLAN_ABS" >&2
      exit 24
    fi
    # Use tandem-review rather than a second copy of the review prompt.
    printf '\n  Requesting a review. The reviewer is being asked to READ this\n' >&2
    printf '  plan, not to build it.\n\n' >&2
    rc=0
    tandem-review "$PLAN_ABS" >&2 || rc=$?
    if (( rc != 0 )); then
      printf '\n  tandem-review failed (rc %s). Nothing was sent and no review\n' "$rc" >&2
      printf '  was requested. Fix that before handing off.\n' >&2
      exit "$rc"
    fi
    printf '\n  The reviewer will wake you with its verdict. Run this handoff\n' >&2
    printf '  again once it has.\n' >&2
  fi
  exit 24
fi

# --- a ruling from an earlier handoff still stands ---
# The gate may have passed on a ruling stored by an earlier handoff. The
# OVERRULED block renders from $OVERRIDE_ID, so adopt the stored ruling here
# or the builder would get no ruling at all.
if [[ -z "$OVERRIDE_ID" ]]; then
  _pass_id=$(printf '%s' "$_gate" | sed -n '1p')
  _pass_meta="$MAILBOX/reviews/$_pass_id.json"
  # Same id shape check as the flag path.
  if [[ "$_pass_id" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+-[0-9]+$ && -f "$_pass_meta" ]]; then
    # Field 2 is the ruling, empty when there is none. A ruling never stands
    # on a clean review, which older sidecars can pair with one.
    tandem gate ruling --relay "$MAILBOX" --id "$_pass_id" >"$FIELDS" 2>/dev/null || true
    { read_field _; read_field _stored; } <"$FIELDS"
    if [[ -n "$_stored" ]]; then
      OVERRIDE_ID="$_pass_id"
      OVERRIDE_REASON="$_stored"
    fi
  fi
fi

rc=0
_snap=$(tandem agent snapshot "$PLANNER_NAME" 2>/dev/null) || rc=$?
if (( rc == 0 )); then
  IFS=$'\t' read -r PLANNER_PANE _ _ <<<"$_snap"
else
  PLANNER_PANE=""
fi
if [[ -z "$PLANNER_PANE" ]]; then
  printf 'tandem-handoff: WARNING no agent named %s.\n' "$PLANNER_NAME" >&2
  printf '               The launch prompt tells the builder to run `tandem-ask %s` and\n' "$PLANNER_NAME" >&2
  printf '               `tandem-handback`, both of which will fail — so its questions and\n' >&2
  printf '               its finished work would have nowhere to go. Run tandem-pair first.\n' >&2
fi

# --- the task to send ---
# Each handoff sends one task brief to a fresh conversation, and the relay
# bridge sends the next after handback. A stopped build resumes at its first
# unfinished task.
BUILDER_KIND=$(tandem config builder-kind --relay "$MAILBOX" 2>/dev/null) || BUILDER_KIND=""
BARGS=( --plan "$PLAN_ABS" --root "$ROOT" --builder "$BUILDER_NAME" --planner "$PLANNER_NAME"
        --check "$CHECK_COMMAND" --budget "${TASK_BUDGET:-0}" )
[[ "${HERDR_JUDGE:-0}" == 1 && -n "${TYPESAFE_API_KEY:-}" ]] && BARGS+=( --judge )
(( CONTINUE )) && BARGS+=( --resume-only )
(( DRY_RUN )) && BARGS+=( --dry-run )
# A durable run needs the builder's kind to choose its transport. The legacy
# engine does not accept the flag. The variable overrides build_engine.
DURABLE_START=0
if [[ "${TANDEM_BUILD_ENGINE:-$PROJ_BUILD_ENGINE}" == durable || -f "$MAILBOX/active-run.json" ]]; then
  DURABLE_START=1
  BARGS+=( --builder-kind "$BUILDER_KIND" )
  [[ -n "$CONTEXT_LIMIT" ]] && BARGS+=( --context-limit "$CONTEXT_LIMIT" )
  # Only new runs read these settings. A persisted run keeps its own.
  if [[ ! -f "$MAILBOX/active-run.json" ]]; then
    [[ -n "$REVIEW_DELIVERY" ]] && BARGS+=( --review-delivery "$REVIEW_DELIVERY" )
    if [[ -n "$ACCEPTANCE_POLICY" ]]; then
      [[ "$ACCEPTANCE_POLICY" == /* ]] || ACCEPTANCE_POLICY="$ROOT/$ACCEPTANCE_POLICY"
      BARGS+=( --acceptance-policy "$ACCEPTANCE_POLICY" )
    fi
    [[ -n "$COLLABORATION" ]] && BARGS+=( --collaboration "$COLLABORATION" )
  fi
fi
# Both engines refuse with 23 when no reviewer pane is recorded.
rc=0
tandem build start "${BARGS[@]}" --fields >"$FIELDS" || rc=$?
# The fields are printed on a refusal too, so read them whatever the exit code.
{ read_field B_ENGINE; read_field RUN_ID; read_field B_DRY_RUN; read_field TASK; read_field TOTAL
  read_field TASK_TITLE; read_field BRIEF; read_field LEDGER_TEXT; read_field RESUMED; read_field REPLACED
  read_field B_JUDGE; read_field REVIEWER_TARGET; read_field REVIEW_PENDING; read_field REVIEW_PROMPT_FILE; } <"$FIELDS"
if (( rc != 0 )); then
  if (( CONTINUE && rc == 23 )); then
    printf 'tandem-handoff: the durable run is paused and needs a person (for example the plan file changed); nothing was sent. See `tandem build status --root %s`.\n' "$ROOT" >&2
    exit "$rc"
  fi
  if (( rc == 23 )) && [[ -z "$RUN_ID" ]]; then
    # Refused before anything was created. The start printed why.
    if (( DURABLE_START )); then
      printf 'tandem-handoff: no durable run was started; the reason is above. Nothing was sent. A task too large for the context limit is raised with --context-limit N, or context_limit in .tandem.json.\n' >&2
    else
      printf 'tandem-handoff: the build was not started; the reason is above. Nothing was sent.\n' >&2
    fi
    exit "$rc"
  fi
  if (( rc == 23 )); then
    printf 'tandem-handoff: the durable run was created but is paused and needs a person; nothing was sent. See `tandem build status --root %s`.\n' "$ROOT" >&2
    exit "$rc"
  fi
  (( CONTINUE )) && { printf 'tandem-handoff: nothing to continue; the plan was NOT delivered.\n' >&2; exit "$rc"; }
  die "could not start the build (rc $rc); the reason is above. Only if it says 'tandem build' is unknown, re-run install.sh."
fi
# A durable dry run creates nothing, so it has no run id.
if (( DRY_RUN )) && [[ "$B_ENGINE" == durable && "$B_DRY_RUN" == true && -z "$RUN_ID" ]]; then
  printf 'tandem-handoff: [dry-run] a durable run would start for %s; nothing was sent.\n' "$BUILDER_NAME"
  exit 0
fi
# A durable run delivers its own prompts, so handoff only ticks it once to
# send the first task. The bridge keeps ticking.
if [[ -n "$RUN_ID" ]]; then
  if (( DRY_RUN )); then
    printf 'tandem-handoff: [dry-run] durable run %s would continue for %s; nothing was sent.\n' "$RUN_ID" "$BUILDER_NAME"
    exit 0
  fi
  rc=0
  tandem build tick --root "$ROOT" >/dev/null 2>"$MAILBOX/.handoff_tick_error" || rc=$?
  if (( rc != 0 )); then
    cat >&2 <<MSG
tandem-handoff: WARNING durable run $RUN_ID exists but its first step failed (rc $rc): $(tail -1 "$MAILBOX/.handoff_tick_error" 2>/dev/null)

  Nothing was recorded as delivered. The relay bridge keeps ticking the run;
  \`tandem build recover --root $ROOT\` continues it by hand, and
  \`tandem build status --root $ROOT\` shows where it is.
MSG
    exit 7
  fi
  verb=started; (( CONTINUE )) && verb=continued
  # Wait until the first send is confirmed or fails for good, so a builder whose
  # turn ends at once is reported instead of "started". Only poll here: ticking
  # would hold the run's lease and starve the bridge.
  WAIT_S="${TANDEM_DISPATCH_WAIT_S:-120}"
  [[ "$WAIT_S" =~ ^[1-9][0-9]*$ ]] || WAIT_S=120
  rc=0
  _werr=$(mktemp "${TMPDIR:-/tmp}/tandem-handoff-wait.XXXXXX")
  tandem build wait --root "$ROOT" --until sent --until-not running \
    --timeout "$(( WAIT_S * 1000 ))" --fields >"$FIELDS" 2>"$_werr" || rc=$?
  _werrtxt=$(cat "$_werr" 2>/dev/null || true); rm -f "$_werr"
  # Printed at the timeout too: the state, its pause code, the first unfinished
  # task's dispatch, and the pause reason.
  { read_field _state; read_field _code; read_field _disp; read_field _reason; } <"$FIELDS"
  if [[ "$_disp" == sent ]]; then
    printf 'tandem-handoff: durable run %s %s for %s.\n' "$RUN_ID" "$verb" "$BUILDER_NAME"
    exit 0
  fi
  if [[ "$_state" == paused && "$_code" == dispatch_failed ]]; then
    cat >&2 <<MSG
tandem-handoff: WARNING durable run $RUN_ID could not deliver its task to $BUILDER_NAME, so nothing is building the plan.

$(printf '%s\n' "${_reason:-No reason was recorded.}" | sed 's/^/    /')

  A model the CLI rejects, an expired login or used-up quota looks like this.
  Fix it in pane $BUILDER_PANE (or re-run tandem-pair), then:

    tandem build stop --root $ROOT
    tandem-handoff $PLAN_ABS
MSG
    exit 8
  fi
  if [[ "$_state" == paused ]]; then
    printf 'tandem-handoff: durable run %s paused (%s) and needs a person; the task was not confirmed as sent. See `tandem build status --root %s`.\n' "$RUN_ID" "${_code:-no code}" "$ROOT" >&2
    exit 23
  fi
  if [[ -n "$_state" && "$_state" != running ]]; then
    printf 'tandem-handoff: durable run %s is %s.\n' "$RUN_ID" "$_state"
    exit 0
  fi
  if (( rc == 23 )); then
    printf 'tandem-handoff: durable run %s %s for %s, but its task was not confirmed as sent within %ss. The relay bridge keeps trying and tells you if it fails; `tandem build status --root %s` shows where it is.\n' \
      "$RUN_ID" "$verb" "$BUILDER_NAME" "$WAIT_S" "$ROOT"
    exit 0
  fi
  if (( rc != 0 )); then
    printf 'tandem-handoff: could not read durable run %s: %s\n' "$RUN_ID" "${_werrtxt:-tandem build wait exited $rc}" >&2
    exit 0
  fi
fi
[[ -n "$REPLACED" ]] && info "WARNING an unfinished build of $REPLACED was replaced; this plan starts again at task 1."
[[ "$TASK" =~ ^[0-9]+$ && "$TOTAL" =~ ^[0-9]+$ && -n "$BRIEF" ]] \
  || die "the build record gave no task to send. The installed tandem may be behind these commands; re-run install.sh."

# A task paused on its review budget already has its implementation. Send the
# stored review prompt to the reviewer pane, with no reset and no `build sent`.
if [[ "$REVIEW_PENDING" == true ]]; then
  # REVIEWER_TARGET is never empty: the start refused above without a reviewer.
  printf 'tandem-handoff: task    %s of %s: %s is paused at its review; sending the review, not the task.\n' "$TASK" "$TOTAL" "$TASK_TITLE"
  if (( DRY_RUN )); then
    # A dry run writes nothing, so the prompt file does not exist yet.
    printf 'tandem-handoff: [dry-run] the stored review prompt would go to %s; nothing was sent.\n' "$REVIEWER_TARGET"
    exit 0
  fi
  [[ -n "$REVIEW_PROMPT_FILE" && -r "$REVIEW_PROMPT_FILE" ]] \
    || die "task $TASK is paused at its review but its review prompt is missing ($REVIEW_PROMPT_FILE). Re-run install.sh if tandem is out of date."
  REVIEWER_PANE=""; REVIEWER_STATUS=""
  rc=0
  _rsnap=$(tandem agent snapshot "$REVIEWER_TARGET" 2>/dev/null) || rc=$?
  (( rc == 0 )) || die "no agent named '$REVIEWER_TARGET', the reviewer pane this build records. Re-run tandem-pair, then hand off again. Nothing was sent."
  IFS=$'\t' read -r REVIEWER_PANE _ REVIEWER_STATUS <<<"$_rsnap"
  [[ "$REVIEWER_STATUS" == blocked ]] \
    && die "$REVIEWER_TARGET is blocked at an approval or question dialog. Inspect pane $REVIEWER_PANE and clear it first."
  # --as proves the prompt started a turn that keeps running.
  rc=0
  _pres=$(tandem agent prompt "$REVIEWER_TARGET" "$(cat "$REVIEW_PROMPT_FILE")" --as review 2>&1) || rc=$?
  IFS=$'\t' read -r _code _msg <<<"$_pres"
  case "$rc" in
    0)
      tandem build review-sent --root "$ROOT" --task "$TASK" >/dev/null 2>&1 \
        || info "WARNING could not record the review of task $TASK as sent."
      info "review of task $TASK handed to '$REVIEWER_TARGET' (now $_msg)."
      exit 0 ;;
    25)
      cat >&2 <<MSG
tandem-handoff: WARNING the review was accepted but $REVIEWER_TARGET never started working.

  It is most likely sitting at a native dialog that Herdr cannot see. Check
  pane $REVIEWER_PANE, clear any dialog, then re-run this command. The review
  is still recorded as pending, so nothing is sent twice.
MSG
      exit 7 ;;
    26)
      turn_ended_at_once "the review of task $TASK" "The review is still recorded as pending, so a re-run sends it again." reviewer "$REVIEWER_PANE"
      exit 8 ;;
  esac
  die "could not send the review to $REVIEWER_TARGET: ${_msg:-${_code:-unknown error}}. Nothing was recorded as sent."
fi

# ==============================================================================
# LAUNCH_PROMPT: the contract handed to the builder for each task.
#
# The template is a quoted heredoc and values are substituted afterwards, so
# repo-supplied text such as prompt_extra is never evaluated by the shell.
# Project-specific wording belongs in .tandem.json prompt_extra. Defaults:
#   1. It does not commit unless the plan says to.
#   2. It runs the check after the task, through `tandem check`.
#   3. The brief outranks this prompt on conflict.
#   4. It reads the brief, never the whole plan.
#   5. It hands back through tandem-handback --task, then stops.
# ==============================================================================
read -r -d '' TEMPLATE <<'TPL' || true
Implement task {{TASK}} of {{TOTAL}} of the plan at {{PLAN}}. Working directory: {{ROOT}}.

Your brief is {{BRIEF}}. Read it first. It holds the plan's goal, its shared
constraints and this one task, which is everything the task needs. Do not read
the plan itself: tandem runs the plan one task at a time, each in a fresh
conversation, so you need no plan-execution workflow either.
{{PRELUDE}}{{LEDGER}}
Then do the task.{{CHECKLINE}} Report the real result, including failures,
with the output. Never call the task done while its tests are red.

If the brief contradicts anything in this message, the brief wins. Say so when
it happens, and carry on.

The reviewer pane reviews each task after you hand it back.
Do not review the task yourself or spawn a reviewer subagent. If the reviewer
asks for changes, tandem sends you its findings here; fix them and hand the
task back again.
{{JUDGE}}
WAIT ONCE, NOT IN A LOOP.
If you spawn a subagent, wait for it in a SINGLE call with the longest timeout
your wait tool accepts. Every wait that expires and has to be reissued re-sends
your whole context to learn nothing, which is the most expensive way to do
nothing available to you. Prefer one long wait to several short ones even when
you expect the work to finish quickly.

The same goes for long commands - {{CHECK}}a full test run, a build.
Run each in ONE blocking call, with the longest wait your command tool
accepts. If your tooling has more than one timeout or yield setting, raise
every one of them. Checking back on a command that is still running re-sends
your whole context each time, exactly like a wait that expires.

ASK BEFORE ASSUMING - but only about INTENT.
When the brief is ambiguous about what the behaviour should BE, ask:

    tandem-ask {{PLANNER}} "your question"

The answer is printed back to you. Ask when a wrong guess means rewriting work.
Do not ask about implementation choices you are equipped to make - how to
structure a function, which helper to reuse. Those are yours.

The call BLOCKS while it waits and prints progress while doing so. Do not run it
again because it is slow: the question is delivered once, and a duplicate costs
the planner a second interruption. If your command runner returns without an exit
code, wait for the answer rather than retrying.

The call is bounded and can fail. If it does, proceed and state the assumption
you made in plain sight, or stop and say you need the human. Never stall.

Do not commit unless the brief explicitly says to. Leave your work in the tree
for review.
{{OVERRULED}}
{{EXTRA}}
When you finish the task - or when you can go no further - hand it back:

    tandem-handback --plan "{{PLAN}}" --task {{TASK}} --report <file>

Add --stuck if you could not finish it. Write the report to a file first and
pass its path; do not paste it on the command line. Keep it under 20 lines. It
must say whether the task is complete, the check's result, anything you changed
that the brief did not ask for, anything you could not verify, and anything a
later task must know that its brief does not say. Later tasks are given it, so
write it for them. Be accurate rather than reassuring: tandem runs the check
itself and records which files you changed.

Hand back even if you failed. A task you could not finish is still news the
planner needs; silence is the one outcome it cannot act on.

That call returns immediately. Then stop. Do not start the next task and do not
close your own pane: tandem checks this task and sends the next one to a fresh
conversation. If something needs fixing, it comes back to you here.
TPL

# Ask for the conventions file only when the CLI does not load it already.
PRELUDE=""
if [[ -n "$CONVENTIONS_FILE" ]]; then
  _loaded=0
  if [[ -n "$BUILDER_KIND" ]]; then
    while IFS= read -r _f; do
      [[ -n "$_f" && "$_f" == "$CONVENTIONS_FILE" ]] && _loaded=1
    done < <(tandem agent instruction-files "$BUILDER_KIND" 2>/dev/null || true)
  fi
  (( _loaded )) || PRELUDE="
Also read $ROOT/$CONVENTIONS_FILE in full before you start. It carries
constraints you cannot infer from the code.
"
fi

# What earlier tasks did, from the build record.
LEDGER=""
[[ -n "$LEDGER_TEXT" ]] && LEDGER="
Earlier tasks, as tandem recorded them. Files and check results are measured;
each note is the account of the conversation that did the task.

$LEDGER_TEXT
"

# `tandem check` keeps the check's output in a log and prints only the result.
if [[ -n "$CHECK_COMMAND" ]]; then
  CHECKLINE=" When it is done, run the project's check ($CHECK_COMMAND)
through tandem, which keeps the full output in a log and shows you only the
result:

    tandem check

If the conventions say the check needs extra arguments where you run, put them
after --, as in: tandem check -- ARGS"
  CHECK="the check (\`tandem check\`), "
else
  CHECKLINE=""
  CHECK=""
fi

# The build owns the triage switch. A resume keeps its first handoff's choice.
JUDGE=""
if [[ "$B_JUDGE" == true ]]; then
  JUDGE="
Tandem decides when a task gets a review. With review triage on, it may skip
one.
"
fi

# Optional staffing advice, off unless HERDR_DECISION=1. Every failure leaves
# ADVICE empty. `tandem decision` reads the builder from the relay record.
ADVICE=""
if (( CONTINUE )); then
  # Staffing advice is given with the first task only.
  info "staffing advice: not asked again for a later task."
elif [[ "${HERDR_DECISION:-0}" == 1 ]]; then
  # --status tells "never asked" apart from "nothing to say". Line 1 is a
  # token, line 2 the reason.
  _st=$(mktemp) || _st=/dev/null
  ADVICE=$(tandem decision assess \
    --plan "$PLAN_ABS" --root "$ROOT" \
    --render --status "$_st" 2>/dev/null) || ADVICE=""
  { read -r _tok; read -r _why; } < "$_st" 2>/dev/null || true
  [[ "$_st" == /dev/null ]] || rm -f "$_st"
  case "${_tok:-}" in
    advice)    info "staffing advice: added to the launch prompt (Jev)." ;;
    no_advice) info "staffing advice: none (Jev answered but was not confident enough about this plan to advise)." ;;
    off)       info "WARNING staffing advice: HERDR_DECISION=1 but TYPESAFE_API_KEY is not set; Jev was not asked." ;;
    *)         info "WARNING staffing advice: the Jev call failed (${_why:-${_tok:-no answer}}); none added." ;;
  esac
else
  info "staffing advice: off (HERDR_DECISION is not 1)."
fi
if [[ -n "$JUDGE" ]]; then
  info "review triage: tandem calls Jev after each task's check."
elif [[ "$RESUMED" == true ]]; then
  info "review triage: off (stored build decision)."
elif [[ "${HERDR_JUDGE:-0}" != 1 ]]; then
  info "review triage: off (HERDR_JUDGE is not 1)."
else
  info "WARNING review triage: off (TYPESAFE_API_KEY is not set)."
fi

# prompt_extra comes last so the repo's own text has the final word.
if [[ -n "$ADVICE" || -n "$PROMPT_EXTRA" ]]; then
  EXTRA="
$ADVICE$PROMPT_EXTRA
"
else
  EXTRA=""
fi

# The ruling is the one exception to "the plan wins". The objection goes with
# it so the builder knows which steps it covers.
OVERRULED=""
if [[ -n "$OVERRIDE_ID" ]]; then
  _obj=$(sed -n '1,40p' "$MAILBOX/reviews/$OVERRIDE_ID.md" 2>/dev/null \
         | sed 's/^/  /') || true
  OVERRULED="
OVERRULED OBJECTIONS
You raised these against this plan and the planner has ruled. These rulings
outrank the plan - they are the only part of this message that does. Do not
raise them again.

$_obj

  RULING: $OVERRIDE_REASON
"
fi

# Each value is defanged into its own _D_* variable. The originals are printed
# to the human below and must stay unchanged.
LAUNCH_PROMPT="$TEMPLATE"
defang_slots _D_PLAN "$PLAN_ABS"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{PLAN\}\}/$_D_PLAN}"
defang_slots _D_ROOT "$ROOT"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{ROOT\}\}/$_D_ROOT}"
defang_slots _D_PLANNER "$PLANNER_NAME"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{PLANNER\}\}/$_D_PLANNER}"
defang_slots _D_PRELUDE "$PRELUDE"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{PRELUDE\}\}/$_D_PRELUDE}"
defang_slots _D_CHECKLINE "$CHECKLINE"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{CHECKLINE\}\}/$_D_CHECKLINE}"
defang_slots _D_CHECK "$CHECK"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{CHECK\}\}/$_D_CHECK}"
defang_slots _D_TASK "$TASK"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{TASK\}\}/$_D_TASK}"
defang_slots _D_TOTAL "$TOTAL"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{TOTAL\}\}/$_D_TOTAL}"
# The brief path and the ledger notes are repo-influenced, so defang them too.
defang_slots _D_BRIEF "$BRIEF"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{BRIEF\}\}/$_D_BRIEF}"
defang_slots _D_LEDGER "$LEDGER"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{LEDGER\}\}/$_D_LEDGER}"
defang_slots _D_JUDGE "$JUDGE"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{JUDGE\}\}/$_D_JUDGE}"
defang_slots _D_EXTRA "$EXTRA"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{EXTRA\}\}/$_D_EXTRA}"
# OVERRULED goes last so no later pass can rewrite the ruling.
defang_slots _D_OVERRULED "$OVERRULED"
LAUNCH_PROMPT="${LAUNCH_PROMPT//\{\{OVERRULED\}\}/$_D_OVERRULED}"

printf 'tandem-handoff: builder %s (pane %s, status: %s)\n' "$BUILDER_NAME" "$BUILDER_PANE" "$BUILDER_STATUS"
printf 'tandem-handoff: project %s (%s)\n' "$ROOT" "$PROJ_SOURCE"
printf 'tandem-handoff: plan    %s\n' "$PLAN_ABS"
_resumed=""
[[ "$RESUMED" == true ]] && _resumed=" (resuming a build that stopped part-way)"
printf 'tandem-handoff: task    %s of %s: %s%s\n' "$TASK" "$TOTAL" "$TASK_TITLE" "$_resumed"
printf 'tandem-handoff: brief   %s\n' "$BRIEF"

if (( DRY_RUN )); then
  say_reset "$(tandem agent reset "$BUILDER_NAME" --root "$ROOT" --dry-run 2>/dev/null || true)"
  printf '\n--- prompt that would be sent ---\n%s\n--- end ---\n' "$LAUNCH_PROMPT"
  exit 0
fi

if [[ "$BUILDER_STATUS" == blocked ]]; then
  die "builder is blocked at an approval or question dialog. Inspect pane $BUILDER_PANE and clear it first."
fi

# The review's findings are already in the plan, so the build starts from an
# empty conversation. A skipped reset only costs tokens.
PRE_SESSION=$(tandem agent session "$BUILDER_NAME" 2>/dev/null) || PRE_SESSION=""
RESET=$(tandem agent reset "$BUILDER_NAME" --root "$ROOT" 2>/dev/null) || RESET=""
say_reset "$RESET"
# `unconfirmed`: nothing visible followed the reset, even after the confirm
# key. The pane may be at a dialog that would swallow the prompt, so send
# nothing.
if [[ "$RESET" == unconfirmed ]]; then
  cat >&2 <<MSG
tandem-handoff: WARNING the builder's reset could not be confirmed, so the plan was NOT sent.

  $BUILDER_NAME may be at a native dialog Herdr cannot see, or still busy.
  Check pane $BUILDER_PANE, clear any dialog, then re-run this command.
MSG
  exit 7
fi

PFLAGS=()
(( WAIT )) && PFLAGS+=( --wait --timeout "$PROMPT_TIMEOUT_MS" )

# `agent prompt` returning 0 does not prove delivery: Herdr reports idle for a
# pane at a native dialog, and a rejected model ends its turn at once. --as
# watches the pane after typing (cmd/tandem/confirm_start.go). --wait waits for
# the turn to settle instead. Without --wait the result is on stdout or stderr,
# so 2>&1 captures it.
rc=0
if (( WAIT )); then
  _pres=$(tandem agent prompt "$BUILDER_NAME" "$LAUNCH_PROMPT" "${PFLAGS[@]}" 2>&1 >/dev/null) || rc=$?
else
  _pres=$(tandem agent prompt "$BUILDER_NAME" "$LAUNCH_PROMPT" --as task 2>&1) || rc=$?
fi
IFS=$'\t' read -r _code _msg <<<"$_pres"

case "$rc" in
  0)
    if (( WAIT )); then
      info "plan handed to '$BUILDER_NAME'."
      info "builder settled at: $(tandem agent status "$BUILDER_NAME" 2>/dev/null || printf 'unknown')"
    else
      info "plan handed to '$BUILDER_NAME' (now $_msg)."
    fi
    record_build_session
    exit 0 ;;
  25)
    cat >&2 <<MSG
tandem-handoff: WARNING the prompt was accepted but $BUILDER_NAME never started working.

  It is most likely sitting at a native dialog that Herdr cannot see, which
  swallows input while still reporting idle. Check pane $BUILDER_PANE, clear
  any dialog, then re-run this command. Do not assume the plan was delivered.
MSG
    exit 7 ;;
  26)
    turn_ended_at_once "the plan" "Do not assume the plan was delivered."
    exit 8 ;;
esac

case "$_code" in
  agent_blocked)        die "builder is waiting at an approval or question dialog; nothing was sent. Inspect pane $BUILDER_PANE." ;;
  agent_input_elsewhere) die "$_msg. Return pane $BUILDER_PANE to its main conversation, then re-run this command." ;;
  agent_prompt_stalled) die "prompt sent but the builder showed no lifecycle change. Inspect pane $BUILDER_PANE." ;;
  *)                    die "could not prompt the builder: ${_msg:-unknown error}" ;;
esac
