#!/usr/bin/env bash
# tandem-unpair: close the builder and reviewer panes and tear the pair down.
#
# The inverse of tandem-pair, run by the planner after it has verified a
# handback. Closing a pane destroys its scrollback, so nothing else does this.
#
# Gates before the close: a handback must exist, the planner must name the one
# it signs off, the project's check must pass, and nothing may change while the
# check runs. Missing panes, bridges or mailboxes are reported and skipped.
#
# See README.md.
set -euo pipefail

# install.sh symlinks the commands, so resolve the link to find lib/.
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _link=$(readlink "$_self"); [[ "$_link" == /* ]] && _self="$_link" || _self="${_self%/*}/$_link"
done
# shellcheck source=lib/unpair-find.sh
. "${_self%/*}/lib/unpair-find.sh"
# shellcheck source=lib/unpair-gates.sh
. "${_self%/*}/lib/unpair-gates.sh"
# shellcheck source=lib/unpair-refusals.sh
. "${_self%/*}/lib/unpair-refusals.sh"
# shellcheck source=lib/unpair-close.sh
. "${_self%/*}/lib/unpair-close.sh"

BUILDER_NAME="${HERDR_BUILDER_NAME:-builder}"
PLANNER_NAME="${HERDR_PLANNER_NAME:-planner}"

DRY_RUN=0
FORCE=0
KEEP_RELAY=0
SKIP_CHECKS=0
CLEAN_TRUST=0
VERIFIED=()

usage() {
  cat <<'USAGE'
usage: tandem-unpair [--verified ID]... [--dry-run] [--force] [--keep-relay]
                    [--skip-checks] [--clean-trust]

Closes the builder's pane and the reviewer pane recorded in reviewer.json
(from the reviewer block or --reviewer), stops the relay bridge and removes
the mailbox.
Run it from the planner, after you have checked the work.

  --verified ID  sign off the handback with this report id (repeatable).
                 Accepts the id, the filename or the full path.
  --skip-checks  do not run the project's check command
  --dry-run      print what would be closed and removed, without doing it
  --force        close regardless of every gate below
  --keep-relay   leave the relay mailbox in place (questions, answers and reports)
  --clean-trust  remove only the project trust entries tandem added (builder and reviewer kinds)

It refuses unless all of these hold:

  - the builder is neither working nor blocked. Closing its pane mid-write
    loses the unfinished work.
  - a reviewer pane is neither working nor blocked. Closing it loses the review.
  - the builder has handed back at least once; an idle builder may simply have
    crashed, or never have been given a plan
  - every handback is signed off with --verified; for a durable run, every
    task is accepted with a passed check and a recorded review (or waivers)
    for its final tree, and handback reports are not consulted
  - the project's check command exits 0
  - nothing moved while that check ran: no new handback, no tree change, and the
    builder did not wake up. A check is evidence only about the state it saw.
USAGE
}

die()  { printf 'tandem-unpair: %s\n' "$*" >&2; exit 1; }

# Refuse when the relay was written by an engine or protocol this install
# does not understand.
engine_guard() {
  local rc=0
  tandem state engine --root "$1" >/dev/null || rc=$?
  case "$rc" in
    0) ;;
    23) exit 23 ;;
    *) die "the installed tandem cannot check which engine owns this relay (rc $rc); re-run install.sh." ;;
  esac
}
info() { printf 'tandem-unpair: %s\n' "$*"; }

SNAP="$(mktemp)"
# tandem answers in NUL-separated fields, which bash reads from a file.
FIELDS="$(mktemp)"
trap 'rm -f "$SNAP" "$FIELDS"' EXIT

while (( $# )); do
  case "$1" in
    --dry-run)     DRY_RUN=1; shift ;;
    --force)       FORCE=1; shift ;;
    --keep-relay)  KEEP_RELAY=1; shift ;;
    --skip-checks) SKIP_CHECKS=1; shift ;;
    --clean-trust) CLEAN_TRUST=1; shift ;;
    --verified)    [[ -n "${2:-}" ]] || die "--verified needs a report id."
                   # Accept an id, a filename or a path.
                   _v="${2##*/}"; VERIFIED+=( "${_v%.md}" ); shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; die "unknown argument: $1" ;;
  esac
done

[[ "${HERDR_ENV:-}" == 1 ]] || die "not running inside a Herdr-managed pane (HERDR_ENV != 1)."
for c in herdr tandem; do
  command -v "$c" >/dev/null 2>&1 || die "$c not found on PATH."
done

find_builder
resolve_mailboxes
find_reviewer
find_bridge
read_durable_id
report_pair

reviewer_gate
read_check_settings
pre_gate
check_gate
post_gate

# Trust cleanup runs after verification and before the builder closes.
if (( CLEAN_TRUST )); then
  clean_trust
fi
if (( DRY_RUN )); then
  print_dry_run
  exit 0
fi

printf '\n'
record_signoff
settle_durable_run
archive_build
close_panes
stop_bridge
remove_mailboxes

printf '\n'
info "unpaired. '$PLANNER_NAME' is on its own; tandem-pair starts a builder again."
