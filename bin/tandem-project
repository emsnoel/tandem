#!/usr/bin/env bash
# tandem-project: resolve per-project settings and print them as JSON.
#
# Settings come from <repo>/.tandem.json or are detected from the repo's build
# files, so the same scripts drive any repo.
#
# Keys: root, plans_dir, check_command, check_paths, conventions_file,
#       builder_kind, prompt_extra, task_input_budget, context_limit,
#       build_engine, review_delivery, acceptance_policy, collaboration
set -euo pipefail

ROOT=""
ROOT_GIVEN=0
usage() { cat <<'USAGE'
usage: tandem-project [--root DIR]

Prints the resolved project settings as JSON. Values come from the nearest
.tandem.json at or above the working directory (a monorepo package's own
manifest wins over one declared further up), otherwise from detection. Run
tandem-init to write a manifest.
USAGE
}

while (( $# )); do
  case "$1" in
    --root) ROOT="${2:-}"; ROOT_GIVEN=1; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; printf 'tandem-project: unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done

command -v jq     >/dev/null 2>&1 || { echo "tandem-project: jq not found on PATH." >&2; exit 1; }
command -v tandem >/dev/null 2>&1 || { echo "tandem-project: tandem not found on PATH; run install.sh." >&2; exit 1; }

if [[ -z "$ROOT" ]]; then
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
  ROOT="${ROOT:-$PWD}"
fi
[[ -d "$ROOT" ]] || { printf 'tandem-project: not a directory: %s\n' "$ROOT" >&2; exit 1; }

# Where the manifest search starts. $ROOT stays the toplevel or --root and is
# echoed back as "root". Without --root the search starts at $PWD, so the
# nearest manifest wins.
if (( ROOT_GIVEN )); then
  SEARCH_FROM="$ROOT"
else
  SEARCH_FROM="$PWD"
fi

# --- detection ---
detect_plans_dir() {
  local d
  for d in docs/superpowers/plans docs/plans plans .plans; do
    [[ -d "$ROOT/$d" ]] && { printf '%s' "$d"; return; }
  done
  printf ''
}

# Prefer a target the repo actually declares over a guess that will not run.
detect_check_command() {
  if [[ -f "$ROOT/package.json" ]]; then
    local k
    for k in check verify ci test; do
      if jq -e --arg k "$k" '.scripts[$k] // empty' "$ROOT/package.json" >/dev/null 2>&1; then
        [[ "$k" == test ]] && printf 'npm test' || printf 'npm run %s' "$k"
        return
      fi
    done
  fi
  [[ -f "$ROOT/Cargo.toml"      ]] && { printf 'cargo test'; return; }
  [[ -f "$ROOT/go.mod"          ]] && { printf 'go test ./...'; return; }
  [[ -f "$ROOT/pyproject.toml"  ]] && { printf 'pytest'; return; }
  local f t
  for f in justfile Justfile Makefile makefile; do
    [[ -f "$ROOT/$f" ]] || continue
    for t in check test; do
      if grep -qE "^$t:" "$ROOT/$f" 2>/dev/null; then
        [[ "$f" == [jJ]ustfile ]] && printf 'just %s' "$t" || printf 'make %s' "$t"
        return
      fi
    done
  done
  printf ''
}

detect_conventions_file() {
  local f
  for f in AGENTS.md CONTRIBUTING.md; do
    [[ -f "$ROOT/$f" ]] && { printf '%s' "$f"; return; }
  done
  printf ''
}

PLANS_DIR=$(detect_plans_dir)
CHECK_COMMAND=$(detect_check_command)
CONVENTIONS_FILE=$(detect_conventions_file)
BUILDER_KIND="codex"
PROMPT_EXTRA=""
# check_paths comes only from the manifest. Empty means the whole tree.
CHECK_PATHS_JSON="[]"
# Input tokens one build task may use before tandem stops the build for a
# human to look. 0 turns it off.
TASK_INPUT_BUDGET=3000000
# Most bytes of prompt a durable run gives the builder for one task. 0 leaves
# `tandem build start` its own default.
CONTEXT_LIMIT=0
# "legacy", "durable" or empty for the default. Only a new build reads it, and
# TANDEM_BUILD_ENGINE overrides it. `tandem build start` validates the value.
BUILD_ENGINE=""
REVIEW_DELIVERY=""
ACCEPTANCE_POLICY=""
COLLABORATION=""

# --- manifest overlay ---
# tandem finds the nearest manifest, up to SEARCH_FROM's git toplevel, so a
# monorepo package's own .tandem.json wins. It also accepts the legacy
# .herdr.json name.
MANIFEST=$(tandem paths manifest --from "$SEARCH_FROM") \
  || { echo "tandem-project: the installed tandem is behind these commands (no 'tandem paths'); re-run install.sh." >&2; exit 1; }
SOURCE="detected"
if [[ -f "$MANIFEST" ]]; then
  if ! jq -e . "$MANIFEST" >/dev/null 2>&1; then
    printf 'tandem-project: %s is not valid JSON; ignoring it.\n' "$MANIFEST" >&2
  else
    SOURCE="manifest"
    read_key() { jq -r --arg k "$1" '.[$k] // empty' "$MANIFEST"; }
    v=$(read_key plans_dir);        [[ -n "$v" ]] && PLANS_DIR="$v"
    v=$(read_key check_command);    [[ -n "$v" ]] && CHECK_COMMAND="$v"
    v=$(read_key conventions_file); [[ -n "$v" ]] && CONVENTIONS_FILE="$v"
    v=$(read_key builder_kind);     [[ -n "$v" ]] && BUILDER_KIND="$v"
    v=$(read_key prompt_extra);     [[ -n "$v" ]] && PROMPT_EXTRA="$v"
    # check_paths must be a JSON array; anything else falls back to the whole tree.
    v=$(jq -c '.check_paths // empty' "$MANIFEST" 2>/dev/null || true)
    [[ "$v" == \[*\] ]] && CHECK_PATHS_JSON="$v"
    # Only a number replaces the default, so a typo cannot turn the budget off.
    v=$(jq -r '.task_input_budget // empty | numbers | floor' "$MANIFEST" 2>/dev/null || true)
    [[ "$v" =~ ^[0-9]+$ ]] && TASK_INPUT_BUDGET="$v"
    v=$(jq -r '.context_limit // empty | numbers | floor' "$MANIFEST" 2>/dev/null || true)
    [[ "$v" =~ ^[0-9]+$ ]] && CONTEXT_LIMIT="$v"
    BUILD_ENGINE=$(read_key build_engine)
    REVIEW_DELIVERY=$(read_key review_delivery)
    ACCEPTANCE_POLICY=$(read_key acceptance_policy)
    COLLABORATION=$(read_key collaboration)
  fi
fi

jq -n \
  --arg root "$ROOT" \
  --arg plans_dir "$PLANS_DIR" \
  --arg check_command "$CHECK_COMMAND" \
  --arg conventions_file "$CONVENTIONS_FILE" \
  --arg builder_kind "$BUILDER_KIND" \
  --arg prompt_extra "$PROMPT_EXTRA" \
  --arg source "$SOURCE" \
  --argjson check_paths "$CHECK_PATHS_JSON" \
  --argjson task_input_budget "$TASK_INPUT_BUDGET" \
  --argjson context_limit "$CONTEXT_LIMIT" \
  --arg build_engine "$BUILD_ENGINE" \
  --arg review_delivery "$REVIEW_DELIVERY" \
  --arg acceptance_policy "$ACCEPTANCE_POLICY" \
  --arg collaboration "$COLLABORATION" \
  '{root:$root, plans_dir:$plans_dir, check_command:$check_command,
    conventions_file:$conventions_file, builder_kind:$builder_kind,
    prompt_extra:$prompt_extra, check_paths:$check_paths,
    task_input_budget:$task_input_budget, context_limit:$context_limit,
    build_engine:$build_engine, review_delivery:$review_delivery,
    acceptance_policy:$acceptance_policy, collaboration:$collaboration, source:$source}'
