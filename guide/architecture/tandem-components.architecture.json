  "cards": [
    {
      "dot": "cyan",
      "title": "Control and relay path",
      "items": [
        "The planner runs bash scripts that call the Go binary and the herdr CLI. Gates are pure functions",
        "The sandboxed builder cannot reach Herdr, so it writes files to the mailbox and the bridge delivers them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two engines",
      "items": [
        "The relay decides: active-run.json is durable, build.json is legacy, both is refused. Legacy is the default; durable is opt-in at build start",
        "Durable applies every change as one SQLite event and never retypes a prompt of unknown delivery"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust limits",
      "items": [
        "Only the user config can widen authority",
        "The builder may reach Jev and nothing else on the network"
      ]
    }
  ]
